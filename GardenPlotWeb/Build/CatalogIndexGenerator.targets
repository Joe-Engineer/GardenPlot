<!--
  CatalogIndexGenerator.targets
  Auto-generates wwwroot/data/catalog/assemblies/_index.json at build and
  publish time, listing every *.json file in that directory except the index
  itself. Ensures the catalog manifest stays synchronized with checked-in
  assembly packs without manual edits.

  Behavior:
    - Runs before PrepareForPublish so the published app has an updated manifest.
    - Also runs on regular Build so dev-time `dotnet run` reflects additions.
    - Skips regeneration if the on-disk index already matches (no-op for clean builds).
    - Output JSON uses sorted file list for deterministic builds.

  Related: #103, #92, PR #101.
-->
<Project>

  <UsingTask
    TaskName="GenerateCatalogIndexJson"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssembliesDirectory ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <Regenerated ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          Regenerated = false;

          if (!Directory.Exists(AssembliesDirectory))
          {
              Log.LogMessage(MessageImportance.Normal,
                  "Catalog index generator: directory '{0}' not found; skipping regeneration.",
                  AssembliesDirectory);
              return true;
          }

          string[] allJsonFiles = Directory.GetFiles(AssembliesDirectory, "*.json", SearchOption.TopDirectoryOnly);
          string[] packFiles = allJsonFiles
              .Select(Path.GetFileName)
              .Where(f => f != "_index.json")
              .OrderBy(f => f, StringComparer.Ordinal)
              .ToArray();

          var sb = new StringBuilder();
          sb.AppendLine("{");
          sb.AppendLine("  \"$comment\": \"Auto-generated by Build/CatalogIndexGenerator.targets. Do not edit by hand; add assembly packs and rebuild.\",");
          sb.AppendLine("  \"files\": [");
          for (int i = 0; i < packFiles.Length; i++)
          {
              sb.Append("    \"");
              sb.Append(packFiles[i]);
              sb.Append("\"");
              if (i < packFiles.Length - 1)
              {
                  sb.AppendLine(",");
              }
              else
              {
                  sb.AppendLine();
              }
          }
          sb.AppendLine("  ]");
          sb.Append("}");

          string newContent = sb.ToString();
          bool needsWrite = true;

          if (File.Exists(OutputFile))
          {
              string oldContent = File.ReadAllText(OutputFile);
              if (oldContent.Equals(newContent, StringComparison.Ordinal))
              {
                  needsWrite = false;
              }
          }

          if (needsWrite)
          {
              File.WriteAllText(OutputFile, newContent, Encoding.UTF8);
              Log.LogMessage(MessageImportance.Normal,
                  "Catalog index generator: wrote {0} pack(s) to '{1}'.",
                  packFiles.Length, Path.GetFileName(OutputFile));
              Regenerated = true;
          }
          else
          {
              Log.LogMessage(MessageImportance.Low,
                  "Catalog index generator: '{0}' is up-to-date ({1} packs).",
                  Path.GetFileName(OutputFile), packFiles.Length);
          }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target
    Name="GenerateCatalogIndex"
    BeforeTargets="PrepareForPublish;CoreBuild"
    Condition="Exists('$(MSBuildProjectDirectory)\wwwroot\data\catalog\assemblies')">

    <GenerateCatalogIndexJson
      AssembliesDirectory="$(MSBuildProjectDirectory)\wwwroot\data\catalog\assemblies"
      OutputFile="$(MSBuildProjectDirectory)\wwwroot\data\catalog\assemblies\_index.json">
      <Output TaskParameter="Regenerated" PropertyName="CatalogIndexRegenerated" />
    </GenerateCatalogIndexJson>

  </Target>

</Project>
