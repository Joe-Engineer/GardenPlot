<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- First-paint Brotli payload budget (3 MB). Enforced after Publish by Build/PayloadBudget.targets. -->
    <WasmFirstPaintBudgetBytes>3145728</WasmFirstPaintBudgetBytes>
    <!-- PWA: lets dotnet publish swap service-worker.js for service-worker.published.js
         (the precache implementation) and emit service-worker-assets.js with hashed
         offline manifest entries. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!--
      Payload-budget mitigations (Phase 11.4) — both verified safe after a grep of
      the codebase:
        * InvariantGlobalization=true removes ~600 KB of ICU locale data. The only
          culture-sensitive usages are date display (`ToString("g", CurrentCulture)`,
          month names, custom format strings) and StringComparer.CurrentCultureIgnoreCase
          for sorting task titles. Both gracefully fall back to invariant behavior
          — date displays always English, sorting always invariant-ordinal — which
          is acceptable for a single-user personal garden app.
        * BlazorEnableTimeZoneSupport=false removes the bundled IANA timezone DB
          (~30 KB). No code calls TimeZoneInfo.FindSystemTimeZoneById; only
          DateTime.ToLocalTime() is used, which works off the browser's UTC offset
          and does not require the IANA DB.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GardenPlot.Tests</_Parameter1>
    </AssemblyAttribute>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PWA service worker swap: dev uses service-worker.js (passthrough so reloads
         always reach the wire); publish replaces it with service-worker.published.js
         (precache + offline). Tied to ServiceWorkerAssetsManifest above. -->
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <Import Project="Build\PayloadBudget.targets" />`n  <Import Project="Build\CatalogIndexGenerator.targets" />`n`n</Project>
