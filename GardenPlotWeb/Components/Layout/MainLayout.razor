@inherits LayoutComponentBase

<input id="nav-collapse-toggle" type="checkbox" class="nav-collapse-toggle" aria-label="Toggle navigation" />

<div class="page">
    <div class="sidebar">
        <NavMenu />
        <label for="nav-collapse-toggle"
               class="nav-collapse-btn"
               title="Collapse/expand navigation"
               aria-label="Collapse/expand navigation"></label>
    </div>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
