@using GardenPlotWeb.Models
@using GardenPlotWeb.Services
@namespace GardenPlotWeb.Components.Pages

@foreach (var s in Shapes)
{
    var sb = GardenPlot.GetBounds(s);
    var scx = sb.x + sb.w / 2;
    var scy = sb.y + sb.h / 2;
    var style = Parent!.GetEffectiveStyle(s);
    <g @key="s.Id" class="shape @(SelectedIds.Contains(s.Id) && !IsConceptMode ? "selected" : string.Empty) @(GardenPlot.IsRulerShape(s) ? "concept-ruler" : string.Empty) @(Parent!.UseConceptPlantEffects(s) ? "concept-shadowed" : string.Empty)"
       transform="rotate(@GardenPlot.F(s.Rotation) @GardenPlot.F(scx) @GardenPlot.F(scy))"
       pointer-events="@(!IsConceptMode && CurrentTool == GardenPlot.Tool.Select && Parent!.CanSelectShape(s) && Parent!.CanReceiveShapePointer(s) ? "auto" : "none")"
       @onpointerdown="(e) => Parent!.OnShapePointerDown(e, s)"
       @onpointerdown:stopPropagation="true"
       @oncontextmenu="(e) => Parent!.OnShapeContextMenu(e, s)"
       @oncontextmenu:preventDefault="true"
       @oncontextmenu:stopPropagation="true">
        @if (Parent!.UseConceptPlantEffects(s) && Parent!.MatureSpreadDiameterFt(s) is double spreadDiameterFt)
        {
            @((MarkupString)PlantRendering.MatureSpreadHaloSvg(scx, scy, spreadDiameterFt, s.Trait))
        }
        @switch (s.Kind)
        {
            case ShapeKind.Rectangle:
                var rectClipId = $"tile-clip-{s.Id:N}";
                <rect class="@((GardenPlot.IsGroundCoverShape(s) && (!string.IsNullOrWhiteSpace(s.TextureKey) || !string.IsNullOrWhiteSpace(s.TextureImageId))) ? "ground-cover-textured" : string.Empty)" x="@GardenPlot.F(s.X)" y="@GardenPlot.F(s.Y)" width="@GardenPlot.F(s.W)" height="@GardenPlot.F(s.H)"
                      fill="@style.Fill" fill-opacity="@GardenPlot.F(style.FillOpacity)"
                      stroke="@style.Stroke" stroke-width="0.06" />
                var rectImgRef = !string.IsNullOrWhiteSpace(s.TextureImageId) ? s.TextureImageId : s.TileBackgroundImageFileName;
                @if (!string.IsNullOrWhiteSpace(rectImgRef))
                {
                    <clipPath id="@rectClipId">
                        <rect x="@GardenPlot.F(s.X)" y="@GardenPlot.F(s.Y)" width="@GardenPlot.F(s.W)" height="@GardenPlot.F(s.H)" />
                    </clipPath>
                    <image href="@GardenPlot.TileImageUrl(rectImgRef!)"
                           data-client-image-id="@GardenPlot.TileImageClientId(rectImgRef)"
                           x="@GardenPlot.F(s.X)" y="@GardenPlot.F(s.Y)" width="@GardenPlot.F(s.W)" height="@GardenPlot.F(s.H)"
                           preserveAspectRatio="xMidYMid slice"
                           clip-path="url(#@rectClipId)" />
                }
                break;
            case ShapeKind.Oval:
                var ovalClipId = $"tile-clip-{s.Id:N}";
                <ellipse class="@((GardenPlot.IsGroundCoverShape(s) && (!string.IsNullOrWhiteSpace(s.TextureKey) || !string.IsNullOrWhiteSpace(s.TextureImageId))) ? "ground-cover-textured" : string.Empty)" cx="@GardenPlot.F(s.X + s.W / 2)" cy="@GardenPlot.F(s.Y + s.H / 2)"
                             rx="@GardenPlot.F(s.W / 2)" ry="@GardenPlot.F(s.H / 2)"
                             fill="@style.Fill" fill-opacity="@GardenPlot.F(style.FillOpacity)"
                             stroke="@style.Stroke" stroke-width="0.06" />
                var ovalImgRef = !string.IsNullOrWhiteSpace(s.TextureImageId) ? s.TextureImageId : s.TileBackgroundImageFileName;
                @if (!string.IsNullOrWhiteSpace(ovalImgRef))
                {
                    <clipPath id="@ovalClipId">
                        <ellipse cx="@GardenPlot.F(s.X + s.W / 2)" cy="@GardenPlot.F(s.Y + s.H / 2)"
                                 rx="@GardenPlot.F(s.W / 2)" ry="@GardenPlot.F(s.H / 2)" />
                    </clipPath>
                    <image href="@GardenPlot.TileImageUrl(ovalImgRef!)"
                           data-client-image-id="@GardenPlot.TileImageClientId(ovalImgRef)"
                           x="@GardenPlot.F(s.X)" y="@GardenPlot.F(s.Y)" width="@GardenPlot.F(s.W)" height="@GardenPlot.F(s.H)"
                           preserveAspectRatio="xMidYMid slice"
                           clip-path="url(#@ovalClipId)" />
                }
                break;
            case ShapeKind.FreeDraw:
                @if (GardenPlot.IsGroundCoverShape(s))
                {
                    var polyClipId = $"poly-clip-{s.Id:N}";
                    @if (ArcPolygonPathBuilder.HasAnyArc(s.EdgeBulges))
                    {
                        @* Issue #130: arc-sided ground cover area renders via <path d=...>. *@
                        var arcD = ArcPolygonPathBuilder.Build(s.Points, s.EdgeBulges, close: true);
                        <path class="@((!string.IsNullOrWhiteSpace(s.TextureKey) || !string.IsNullOrWhiteSpace(s.TextureImageId)) ? "ground-cover-textured" : string.Empty)"
                              d="@arcD"
                              fill="@style.Fill" fill-opacity="@GardenPlot.F(style.FillOpacity)"
                              stroke="@style.Stroke" stroke-width="0.08"
                              stroke-linejoin="round" />
                        @if (!string.IsNullOrWhiteSpace(s.TextureImageId))
                        {
                            <clipPath id="@polyClipId">
                                <path d="@arcD" />
                            </clipPath>
                            <image href="@GardenPlot.TileImageUrl(s.TextureImageId!)"
                                   data-client-image-id="@GardenPlot.TileImageClientId(s.TextureImageId)"
                                   x="@GardenPlot.F(sb.x)" y="@GardenPlot.F(sb.y)" width="@GardenPlot.F(sb.w)" height="@GardenPlot.F(sb.h)"
                                   preserveAspectRatio="xMidYMid slice"
                                   clip-path="url(#@polyClipId)" />
                        }
                    }
                    else
                    {
                        <polygon class="@((!string.IsNullOrWhiteSpace(s.TextureKey) || !string.IsNullOrWhiteSpace(s.TextureImageId)) ? "ground-cover-textured" : string.Empty)" points="@GardenPlot.PointsString(s.Points)"
                                 fill="@style.Fill" fill-opacity="@GardenPlot.F(style.FillOpacity)"
                                 stroke="@style.Stroke" stroke-width="0.08"
                                 stroke-linejoin="round" />
                        @if (!string.IsNullOrWhiteSpace(s.TextureImageId))
                        {
                            <clipPath id="@polyClipId">
                                <polygon points="@GardenPlot.PointsString(s.Points)" />
                            </clipPath>
                            <image href="@GardenPlot.TileImageUrl(s.TextureImageId!)"
                                   data-client-image-id="@GardenPlot.TileImageClientId(s.TextureImageId)"
                                   x="@GardenPlot.F(sb.x)" y="@GardenPlot.F(sb.y)" width="@GardenPlot.F(sb.w)" height="@GardenPlot.F(sb.h)"
                                   preserveAspectRatio="xMidYMid slice"
                                   clip-path="url(#@polyClipId)" />
                        }
                    }
                }
                else if (s.CloseEdge && s.Points.Count >= 3)
                {
                    @* Issue #120: closed Polygon tool — FreeDraw shape with CloseEdge=true renders as a filled polygon. *@
                    @* Issue #130: arc-sided polygons switch to <path d=...> when any edge has a non-zero bulge. *@
                    @if (ArcPolygonPathBuilder.HasAnyArc(s.EdgeBulges))
                    {
                        <path d="@ArcPolygonPathBuilder.Build(s.Points, s.EdgeBulges, close: true)"
                              fill="@style.Fill" fill-opacity="@GardenPlot.F(style.FillOpacity)"
                              stroke="@style.Stroke" stroke-width="0.08"
                              stroke-linejoin="round" />
                    }
                    else
                    {
                        <polygon points="@GardenPlot.PointsString(s.Points)"
                                 fill="@style.Fill" fill-opacity="@GardenPlot.F(style.FillOpacity)"
                                 stroke="@style.Stroke" stroke-width="0.08"
                                 stroke-linejoin="round" />
                    }
                }
                else
                {
                    @if (ArcPolygonPathBuilder.HasAnyArc(s.EdgeBulges))
                    {
                        <path d="@ArcPolygonPathBuilder.Build(s.Points, s.EdgeBulges, close: false)"
                              fill="none" stroke="@style.Stroke" stroke-width="0.08"
                              stroke-linecap="round" stroke-linejoin="round" />
                    }
                    else
                    {
                        <polyline points="@GardenPlot.PointsString(s.Points)"
                                  fill="none" stroke="@style.Stroke" stroke-width="0.08"
                                  stroke-linecap="round" stroke-linejoin="round" />
                    }
                }
                <rect x="@GardenPlot.F(sb.x - 0.1)" y="@GardenPlot.F(sb.y - 0.1)"
                      width="@GardenPlot.F(sb.w + 0.2)" height="@GardenPlot.F(sb.h + 0.2)"
                      fill="transparent" stroke="none" />
                break;
            case ShapeKind.Edge:
                @if (s.CloseEdge && s.Points.Count > 1)
                {
                    <polygon points="@GardenPlot.PointsString(s.Points)"
                             fill="none" stroke="@style.Stroke" stroke-width="@GardenPlot.F(GardenPlot.EdgeStrokeWidthFt(s))"
                             stroke-linecap="round" stroke-linejoin="round" />
                }
                else
                {
                    <polyline points="@GardenPlot.PointsString(s.Points)"
                              fill="none" stroke="@style.Stroke" stroke-width="@GardenPlot.F(GardenPlot.EdgeStrokeWidthFt(s))"
                              stroke-linecap="round" stroke-linejoin="round" />
                }
                <rect x="@GardenPlot.F(sb.x - 0.1)" y="@GardenPlot.F(sb.y - 0.1)"
                      width="@GardenPlot.F(sb.w + 0.2)" height="@GardenPlot.F(sb.h + 0.2)"
                      fill="transparent" stroke="none" />
                break;
            case ShapeKind.CircleRuler:
                <circle cx="@GardenPlot.F(s.X + (s.W / 2))" cy="@GardenPlot.F(s.Y + (s.H / 2))" r="@GardenPlot.F(s.W / 2)"
                        fill="@style.Fill" fill-opacity="@GardenPlot.F(style.FillOpacity)"
                        stroke="@style.Stroke" stroke-width="0.06" />
                @((MarkupString)GardenPlot.CircleRulerLabelsSvg(s))
                @if (CurrentTool == GardenPlot.Tool.Select)
                {
                    @((MarkupString)GardenPlot.CircleRulerGrabbersSvg(s, SelectedIds.Contains(s.Id)))
                }
                break;
            case ShapeKind.RectRuler:
                <rect x="@GardenPlot.F(s.X)" y="@GardenPlot.F(s.Y)" width="@GardenPlot.F(s.W)" height="@GardenPlot.F(s.H)"
                      fill="@style.Fill" fill-opacity="@GardenPlot.F(style.FillOpacity)"
                      stroke="@style.Stroke" stroke-width="0.06" />
                @((MarkupString)GardenPlot.RectRulerLabelsSvg(s))
                @if (CurrentTool == GardenPlot.Tool.Select)
                {
                    @((MarkupString)GardenPlot.RectRulerGrabbersSvg(s, SelectedIds.Contains(s.Id)))
                }
                break;
            case ShapeKind.Ruler:
                <polyline points="@GardenPlot.PointsString(s.Points)"
                          fill="none" stroke="@style.Stroke" stroke-width="0.06"
                          stroke-linecap="round" stroke-linejoin="round" />
                @foreach (var p in s.Points)
                {
                    <circle cx="@GardenPlot.F(p.X)" cy="@GardenPlot.F(p.Y)" r="0.08"
                            fill="#fff" stroke="@style.Stroke" stroke-width="0.04" />
                }
                @((MarkupString)GardenPlot.RulerLabelsSvg(s))
                <rect x="@GardenPlot.F(sb.x - 0.1)" y="@GardenPlot.F(sb.y - 0.1)"
                      width="@GardenPlot.F(sb.w + 0.2)" height="@GardenPlot.F(sb.h + 0.2)"
                      fill="transparent" stroke="none" />
                break;
            case ShapeKind.BedKit:
                <g transform="translate(@GardenPlot.F(s.X) @GardenPlot.F(s.Y))">
                    <rect x="0" y="0" width="@GardenPlot.F(s.W)" height="@GardenPlot.F(s.H)"
                          rx="@GardenPlot.F(Math.Min(s.W, s.H) / 3.0)"
                          ry="@GardenPlot.F(Math.Min(s.W, s.H) / 3.0)"
                          fill="@style.Fill" fill-opacity="@GardenPlot.F(style.FillOpacity)"
                          stroke="@style.Stroke" stroke-width="0.08" />
                    <text x="@GardenPlot.F(s.W / 2)" y="@GardenPlot.F(s.H / 2)"
                          text-anchor="middle" dominant-baseline="middle"
                          font-size="@GardenPlot.F((Math.Min(s.W, s.H) * 0.18) * style.FontScale)" fill="#3d1c10"
                          style="font-family: sans-serif; pointer-events:none;">@s.Label</text>
                </g>
                break;
            case ShapeKind.Tree:
                @((MarkupString)PlantRendering.TreeSvg(s.X, s.Y, s.W, s.H, s.Trait, s.Label))
                break;
            case ShapeKind.Bush:
                @((MarkupString)PlantRendering.BushSvg(s.X, s.Y, s.W, s.H, s.Trait, s.Label))
                break;
            case ShapeKind.Plant:
                @((MarkupString)PlantRendering.PlantSpriteSvg(s.X + s.W / 2, s.Y + s.H / 2, s.W, s.Trait))
                break;
            case ShapeKind.SoilMarker:
                @((MarkupString)PlantRendering.SoilMarkerSvg(s.X, s.Y, s.W, s.H, s.Label, style.Fill, style.Stroke))
                break;
            case ShapeKind.IrrigationHead:
                @* Issue #31 Phase A — irrigation head + throw halo. The halo is water-blue at
                   15% opacity with a dotted outline; the head body is a small filled circle
                   centered on the throw center. Catalog stores throw diameter as WidthFt so
                   throw radius = s.W / 2. When ArcDegrees < 360, draw a wedge (path) instead
                   of a full circle; the shape's outer rotation transform rotates the wedge. *@
                {
                    var headCx = s.X + s.W / 2;
                    var headCy = s.Y + s.H / 2;
                    var throwR = s.W / 2;
                    var headBodyR = Math.Max(0.18, Math.Min(0.6, throwR * 0.06));
                    if (GardenPlotWeb.Models.SprinklerArcGeometry.IsFullCircle(s.ArcDegrees))
                    {
                        <circle cx="@GardenPlot.F(headCx)" cy="@GardenPlot.F(headCy)" r="@GardenPlot.F(throwR)"
                                fill="#3aa9d4" fill-opacity="0.15"
                                stroke="#1f6f8b" stroke-width="0.05"
                                stroke-dasharray="0.1 0.1" />
                    }
                    else
                    {
                        var arcD = GardenPlotWeb.Models.SprinklerArcGeometry.BuildArcPath(headCx, headCy, throwR, s.ArcDegrees ?? 360);
                        <path d="@arcD"
                              fill="#3aa9d4" fill-opacity="0.15"
                              stroke="#1f6f8b" stroke-width="0.05"
                              stroke-dasharray="0.1 0.1"
                              stroke-linejoin="round" />
                    }
                    <circle cx="@GardenPlot.F(headCx)" cy="@GardenPlot.F(headCy)" r="@GardenPlot.F(headBodyR)"
                            fill="#1f6f8b" stroke="#fff" stroke-width="0.04" />
                }

                break;
            case ShapeKind.IrrigationPipe:
                @* Issue #159 — irrigation pipe rendered as a polyline whose stroke width
                   scales with the pipe's nominal diameter (inches → feet via /12 with a
                   visual amplification factor) and whose stroke color comes from material
                   (PVC=light grey, Poly=near-black, Copper=copper-orange, DripTubing=dark
                   grey). Drawn AFTER the head halos so pipes appear over the wedges. *@
                @if (s.Points.Count >= 2)
                {
                    double diameterIn = s.PipeDiameterIn ?? (s.W * 12);
                    if (diameterIn <= 0) { diameterIn = 0.5; }
                    // Visual stroke: amplify by 3x so a 1" pipe reads as 0.25 ft on canvas;
                    // tight enough to follow the polyline accurately, thick enough to feel
                    // like infrastructure rather than a sketch line.
                    double strokeFt = (diameterIn / 12.0) * 3.0;
                    string pipeColor = s.Trait switch
                    {
                        "PVC" => "#cfd0d2",
                        "Poly" => "#2a2a2a",
                        "Copper" => "#b7521a",
                        "DripTubing" => "#3a3a3a",
                        _ => s.Stroke ?? "#5a5a5a",
                    };
                    <polyline points="@GardenPlot.PointsString(s.Points)"
                              fill="none" stroke="@pipeColor" stroke-width="@GardenPlot.F(strokeFt)"
                              stroke-linecap="round" stroke-linejoin="round" />
                }

                break;
            case ShapeKind.WaterSource:
                @* Issue #160 — water source: distinct anchor icon per source type.
                   Faucet: blue wall-bib (rectangle with spout). Spring: green bubbling
                   circle with concentric ripples. Pump: amber rounded box with arrow.
                   All centered at the shape's bbox center; W = icon footprint. *@
                {
                    var srcCx = s.X + s.W / 2;
                    var srcCy = s.Y + s.H / 2;
                    var srcR = s.W / 2;
                    var srcFill = s.Fill ?? "#9bc7e0";
                    var srcStroke = s.Stroke ?? "#1f4e7a";
                    var srcType = s.WaterSourceType;
                    if (srcType == GardenPlotWeb.Models.WaterSourceType.Faucet)
                    {
                        <rect x="@GardenPlot.F(s.X)" y="@GardenPlot.F(s.Y + s.H * 0.2)"
                              width="@GardenPlot.F(s.W * 0.65)" height="@GardenPlot.F(s.H * 0.6)"
                              fill="@srcFill" stroke="@srcStroke" stroke-width="0.08" rx="@GardenPlot.F(srcR * 0.1)" />
                        <rect x="@GardenPlot.F(s.X + s.W * 0.65)" y="@GardenPlot.F(s.Y + s.H * 0.4)"
                              width="@GardenPlot.F(s.W * 0.3)" height="@GardenPlot.F(s.H * 0.2)"
                              fill="@srcStroke" />
                        <circle cx="@GardenPlot.F(s.X + s.W * 0.3)" cy="@GardenPlot.F(srcCy)" r="@GardenPlot.F(srcR * 0.15)"
                                fill="@srcStroke" />
                    }
                    else if (srcType == GardenPlotWeb.Models.WaterSourceType.Spring)
                    {
                        <circle cx="@GardenPlot.F(srcCx)" cy="@GardenPlot.F(srcCy)" r="@GardenPlot.F(srcR)"
                                fill="@srcFill" stroke="@srcStroke" stroke-width="0.08" />
                        <circle cx="@GardenPlot.F(srcCx)" cy="@GardenPlot.F(srcCy)" r="@GardenPlot.F(srcR * 0.65)"
                                fill="none" stroke="@srcStroke" stroke-width="0.05" />
                        <circle cx="@GardenPlot.F(srcCx)" cy="@GardenPlot.F(srcCy)" r="@GardenPlot.F(srcR * 0.3)"
                                fill="@srcStroke" />
                    }
                    else if (srcType == GardenPlotWeb.Models.WaterSourceType.Pump)
                    {
                        <rect x="@GardenPlot.F(s.X)" y="@GardenPlot.F(s.Y)" width="@GardenPlot.F(s.W)" height="@GardenPlot.F(s.H)"
                              fill="@srcFill" stroke="@srcStroke" stroke-width="0.08" rx="@GardenPlot.F(srcR * 0.15)" />
                        <circle cx="@GardenPlot.F(srcCx)" cy="@GardenPlot.F(srcCy)" r="@GardenPlot.F(srcR * 0.4)"
                                fill="@srcStroke" />
                        <path d="M @GardenPlot.F(s.X + s.W * 0.6) @GardenPlot.F(srcCy) L @GardenPlot.F(s.X + s.W * 0.95) @GardenPlot.F(srcCy)"
                              stroke="@srcStroke" stroke-width="0.1" />
                        <path d="M @GardenPlot.F(s.X + s.W * 0.85) @GardenPlot.F(srcCy - srcR * 0.18) L @GardenPlot.F(s.X + s.W * 0.95) @GardenPlot.F(srcCy) L @GardenPlot.F(s.X + s.W * 0.85) @GardenPlot.F(srcCy + srcR * 0.18) Z"
                              fill="@srcStroke" />
                    }
                    else
                    {
                        <circle cx="@GardenPlot.F(srcCx)" cy="@GardenPlot.F(srcCy)" r="@GardenPlot.F(srcR)"
                                fill="@srcFill" stroke="@srcStroke" stroke-width="0.08" />
                    }
                }

                break;
            case ShapeKind.IrrigationControl:
                @* Issue #161 — irrigation control: distinct icon per control type. All centered
                   at the shape's bbox center; W/H = icon footprint from the catalog. *@
                {
                    var ctrlCx = s.X + s.W / 2;
                    var ctrlCy = s.Y + s.H / 2;
                    var ctrlMin = Math.Min(s.W, s.H);
                    var ctrlFill = s.Fill ?? "#bdbdbd";
                    var ctrlStroke = s.Stroke ?? "#2c2c2c";
                    var ctrlType = s.IrrigationControlType;
                    if (ctrlType == GardenPlotWeb.Models.IrrigationControlType.Controller)
                    {
                        @* Controller: dark housing + display strip + status LED. *@
                        <rect x="@GardenPlot.F(s.X)" y="@GardenPlot.F(s.Y)"
                              width="@GardenPlot.F(s.W)" height="@GardenPlot.F(s.H)"
                              fill="@ctrlFill" stroke="@ctrlStroke" stroke-width="0.06" rx="@GardenPlot.F(ctrlMin * 0.1)" />
                        <rect x="@GardenPlot.F(s.X + s.W * 0.15)" y="@GardenPlot.F(s.Y + s.H * 0.2)"
                              width="@GardenPlot.F(s.W * 0.7)" height="@GardenPlot.F(s.H * 0.3)"
                              fill="#1a1a2a" />
                        <circle cx="@GardenPlot.F(s.X + s.W * 0.85)" cy="@GardenPlot.F(s.Y + s.H * 0.75)"
                                r="@GardenPlot.F(ctrlMin * 0.08)" fill="#5cb85c" />
                    }
                    else if (ctrlType == GardenPlotWeb.Models.IrrigationControlType.Manifold)
                    {
                        @* Manifold: horizontal bar with N circles for valve slots. *@
                        var slots = s.ZoneOutputs ?? 4;
                        if (slots < 1) { slots = 1; }
                        <rect x="@GardenPlot.F(s.X)" y="@GardenPlot.F(s.Y)"
                              width="@GardenPlot.F(s.W)" height="@GardenPlot.F(s.H)"
                              fill="@ctrlFill" stroke="@ctrlStroke" stroke-width="0.06" rx="@GardenPlot.F(ctrlMin * 0.15)" />
                        @for (int slotIdx = 0; slotIdx < slots; slotIdx++)
                        {
                            var slotCx = s.X + s.W * ((slotIdx + 0.5) / slots);
                            <circle cx="@GardenPlot.F(slotCx)" cy="@GardenPlot.F(ctrlCy)"
                                    r="@GardenPlot.F(ctrlMin * 0.18)" fill="@ctrlStroke" />
                        }
                    }
                    else if (ctrlType == GardenPlotWeb.Models.IrrigationControlType.Valve)
                    {
                        @* Valve: solenoid symbol (circle with diagonal slash + small box on top). *@
                        <circle cx="@GardenPlot.F(ctrlCx)" cy="@GardenPlot.F(ctrlCy)" r="@GardenPlot.F(ctrlMin * 0.45)"
                                fill="@ctrlFill" stroke="@ctrlStroke" stroke-width="0.06" />
                        <path d="M @GardenPlot.F(ctrlCx - ctrlMin * 0.3) @GardenPlot.F(ctrlCy - ctrlMin * 0.3) L @GardenPlot.F(ctrlCx + ctrlMin * 0.3) @GardenPlot.F(ctrlCy + ctrlMin * 0.3)"
                              stroke="@ctrlStroke" stroke-width="0.05" />
                        <rect x="@GardenPlot.F(ctrlCx - ctrlMin * 0.15)" y="@GardenPlot.F(s.Y)"
                              width="@GardenPlot.F(ctrlMin * 0.3)" height="@GardenPlot.F(ctrlMin * 0.15)"
                              fill="@ctrlStroke" />
                    }
                    else if (ctrlType == GardenPlotWeb.Models.IrrigationControlType.Backflow)
                    {
                        @* Backflow: hourglass / bow-tie shape (matches industry symbol). *@
                        <path d="M @GardenPlot.F(s.X) @GardenPlot.F(s.Y) L @GardenPlot.F(s.X + s.W) @GardenPlot.F(s.Y + s.H) L @GardenPlot.F(s.X + s.W) @GardenPlot.F(s.Y) L @GardenPlot.F(s.X) @GardenPlot.F(s.Y + s.H) Z"
                              fill="@ctrlFill" stroke="@ctrlStroke" stroke-width="0.06" />
                    }
                    else if (ctrlType == GardenPlotWeb.Models.IrrigationControlType.PressureRegulator)
                    {
                        @* Pressure regulator: downward-pointing funnel (high → low pressure). *@
                        <path d="M @GardenPlot.F(s.X) @GardenPlot.F(s.Y) L @GardenPlot.F(s.X + s.W) @GardenPlot.F(s.Y) L @GardenPlot.F(ctrlCx + ctrlMin * 0.2) @GardenPlot.F(s.Y + s.H * 0.6) L @GardenPlot.F(ctrlCx + ctrlMin * 0.2) @GardenPlot.F(s.Y + s.H) L @GardenPlot.F(ctrlCx - ctrlMin * 0.2) @GardenPlot.F(s.Y + s.H) L @GardenPlot.F(ctrlCx - ctrlMin * 0.2) @GardenPlot.F(s.Y + s.H * 0.6) Z"
                              fill="@ctrlFill" stroke="@ctrlStroke" stroke-width="0.06" />
                    }
                    else if (ctrlType == GardenPlotWeb.Models.IrrigationControlType.Filter)
                    {
                        @* Filter: circle with mesh / cross-hatch pattern. *@
                        <circle cx="@GardenPlot.F(ctrlCx)" cy="@GardenPlot.F(ctrlCy)" r="@GardenPlot.F(ctrlMin * 0.45)"
                                fill="@ctrlFill" stroke="@ctrlStroke" stroke-width="0.06" />
                        <path d="M @GardenPlot.F(ctrlCx - ctrlMin * 0.35) @GardenPlot.F(ctrlCy) L @GardenPlot.F(ctrlCx + ctrlMin * 0.35) @GardenPlot.F(ctrlCy) M @GardenPlot.F(ctrlCx) @GardenPlot.F(ctrlCy - ctrlMin * 0.35) L @GardenPlot.F(ctrlCx) @GardenPlot.F(ctrlCy + ctrlMin * 0.35) M @GardenPlot.F(ctrlCx - ctrlMin * 0.25) @GardenPlot.F(ctrlCy - ctrlMin * 0.25) L @GardenPlot.F(ctrlCx + ctrlMin * 0.25) @GardenPlot.F(ctrlCy + ctrlMin * 0.25) M @GardenPlot.F(ctrlCx - ctrlMin * 0.25) @GardenPlot.F(ctrlCy + ctrlMin * 0.25) L @GardenPlot.F(ctrlCx + ctrlMin * 0.25) @GardenPlot.F(ctrlCy - ctrlMin * 0.25)"
                              stroke="@ctrlStroke" stroke-width="0.04" />
                    }
                    else if (ctrlType == GardenPlotWeb.Models.IrrigationControlType.QuickCoupler)
                    {
                        @* Quick-coupler: socket — outer ring + inner ring + center dot. *@
                        <circle cx="@GardenPlot.F(ctrlCx)" cy="@GardenPlot.F(ctrlCy)" r="@GardenPlot.F(ctrlMin * 0.45)"
                                fill="@ctrlFill" stroke="@ctrlStroke" stroke-width="0.06" />
                        <circle cx="@GardenPlot.F(ctrlCx)" cy="@GardenPlot.F(ctrlCy)" r="@GardenPlot.F(ctrlMin * 0.28)"
                                fill="none" stroke="@ctrlStroke" stroke-width="0.04" />
                        <circle cx="@GardenPlot.F(ctrlCx)" cy="@GardenPlot.F(ctrlCy)" r="@GardenPlot.F(ctrlMin * 0.12)"
                                fill="@ctrlStroke" />
                    }
                    else
                    {
                        @* Fallback: plain rounded rect. *@
                        <rect x="@GardenPlot.F(s.X)" y="@GardenPlot.F(s.Y)"
                              width="@GardenPlot.F(s.W)" height="@GardenPlot.F(s.H)"
                              fill="@ctrlFill" stroke="@ctrlStroke" stroke-width="0.06" rx="@GardenPlot.F(ctrlMin * 0.15)" />
                    }
                }

                break;
            case ShapeKind.IrrigationWire:
                @* Issue #161 — irrigation wire as a thin dashed polyline. Stroke is thinner
                   than the slimmest pipe so wire doesn't compete visually with plumbing. *@
                @if (s.Points.Count >= 2)
                {
                    string wireColor = s.Stroke ?? "#7a1f4a";
                    <polyline points="@GardenPlot.PointsString(s.Points)"
                              fill="none" stroke="@wireColor" stroke-width="0.05"
                              stroke-dasharray="0.18,0.12" stroke-linecap="round" stroke-linejoin="round" />
                }

                break;
            case ShapeKind.IrrigationFitting:
                @* Issue #162a — pipe fitting: distinct icon per fitting type, sized to the
                   fitting's diameter (footprint = diameterFt × 1.6 for visual weight). All
                   centered at the shape's bbox center. *@
                {
                    var fitCx = s.X + s.W / 2;
                    var fitCy = s.Y + s.H / 2;
                    var fitR = Math.Max(s.W, s.H) * 0.6;
                    var fitFill = s.Fill ?? "#cfd0d2";
                    var fitStroke = s.Stroke ?? "#5a5a5a";
                    var fitType = s.FittingType;
                    if (fitType == GardenPlotWeb.Models.FittingType.Elbow90)
                    {
                        @* 90° elbow: small filled square rotated 45° (diamond) with a corner dot. *@
                        <rect x="@GardenPlot.F(fitCx - fitR * 0.7)" y="@GardenPlot.F(fitCy - fitR * 0.7)"
                              width="@GardenPlot.F(fitR * 1.4)" height="@GardenPlot.F(fitR * 1.4)"
                              fill="@fitFill" stroke="@fitStroke" stroke-width="0.04"
                              transform="rotate(45 @GardenPlot.F(fitCx) @GardenPlot.F(fitCy))" />
                    }
                    else if (fitType == GardenPlotWeb.Models.FittingType.Elbow45)
                    {
                        @* 45° elbow: smaller filled square rotated 22.5° for distinction. *@
                        <rect x="@GardenPlot.F(fitCx - fitR * 0.6)" y="@GardenPlot.F(fitCy - fitR * 0.6)"
                              width="@GardenPlot.F(fitR * 1.2)" height="@GardenPlot.F(fitR * 1.2)"
                              fill="@fitFill" stroke="@fitStroke" stroke-width="0.04"
                              transform="rotate(22.5 @GardenPlot.F(fitCx) @GardenPlot.F(fitCy))" />
                    }
                    else if (fitType == GardenPlotWeb.Models.FittingType.Tee)
                    {
                        @* Tee: T-shape (horizontal bar + vertical stem). *@
                        <rect x="@GardenPlot.F(fitCx - fitR * 0.9)" y="@GardenPlot.F(fitCy - fitR * 0.25)"
                              width="@GardenPlot.F(fitR * 1.8)" height="@GardenPlot.F(fitR * 0.5)"
                              fill="@fitFill" stroke="@fitStroke" stroke-width="0.04" />
                        <rect x="@GardenPlot.F(fitCx - fitR * 0.25)" y="@GardenPlot.F(fitCy - fitR * 0.25)"
                              width="@GardenPlot.F(fitR * 0.5)" height="@GardenPlot.F(fitR * 0.9)"
                              fill="@fitFill" stroke="@fitStroke" stroke-width="0.04" />
                    }
                    else if (fitType == GardenPlotWeb.Models.FittingType.Coupling)
                    {
                        @* Coupling: short narrow rectangle (a bushing along the pipe). *@
                        <rect x="@GardenPlot.F(fitCx - fitR * 0.7)" y="@GardenPlot.F(fitCy - fitR * 0.25)"
                              width="@GardenPlot.F(fitR * 1.4)" height="@GardenPlot.F(fitR * 0.5)"
                              fill="@fitFill" stroke="@fitStroke" stroke-width="0.04" />
                    }
                    else if (fitType == GardenPlotWeb.Models.FittingType.Adapter)
                    {
                        @* Adapter / reducer: trapezoid (wide → narrow). *@
                        <path d="M @GardenPlot.F(fitCx - fitR * 0.9) @GardenPlot.F(fitCy - fitR * 0.5) L @GardenPlot.F(fitCx + fitR * 0.9) @GardenPlot.F(fitCy - fitR * 0.3) L @GardenPlot.F(fitCx + fitR * 0.9) @GardenPlot.F(fitCy + fitR * 0.3) L @GardenPlot.F(fitCx - fitR * 0.9) @GardenPlot.F(fitCy + fitR * 0.5) Z"
                              fill="@fitFill" stroke="@fitStroke" stroke-width="0.04" />
                    }
                    else
                    {
                        @* Fallback: filled circle. *@
                        <circle cx="@GardenPlot.F(fitCx)" cy="@GardenPlot.F(fitCy)" r="@GardenPlot.F(fitR * 0.6)"
                                fill="@fitFill" stroke="@fitStroke" stroke-width="0.04" />
                    }
                }

                break;
        }
        @if (!IsConceptMode && SelectedIds.Contains(s.Id))
        {
            <rect x="@GardenPlot.F(sb.x - 0.05)" y="@GardenPlot.F(sb.y - 0.05)"
                  width="@GardenPlot.F(sb.w + 0.1)" height="@GardenPlot.F(sb.h + 0.1)"
                  fill="none" stroke="#0d6efd" stroke-width="0.05"
                  stroke-dasharray="0.15,0.1" pointer-events="none" />

            @* Issue #130: per-vertex SQUARE handles + per-edge CIRCLE midpoint handles on
               selected FreeDraw polygons. Vertices reposition with no effect on bulges
               (the arc on either side follows the new endpoints). Midpoints adjust the
               bulge of their edge; releasing within snap tolerance of the chord restores
               a straight line. Different shapes/colors keep the two affordances visually
               distinct: squares + blue for vertices, circles + cream/amber for arcs. *@
            @if (CurrentTool == GardenPlot.Tool.Select && s.Kind == ShapeKind.FreeDraw && s.Points.Count >= 2)
            {
                var capturedShapeId = s.Id;
                @for (int vIdx = 0; vIdx < s.Points.Count; vIdx++)
                {
                    var localVertexIdx = vIdx;
                    var vp = s.Points[localVertexIdx];
                    <rect x="@GardenPlot.F(vp.X - 0.1)" y="@GardenPlot.F(vp.Y - 0.1)"
                          width="0.2" height="0.2"
                          fill="#e7f1ff" stroke="#0d6efd" stroke-width="0.04" cursor="move"
                          pointer-events="auto"
                          @onpointerdown="@(e => Parent!.OnShapeVertexPointerDown(e, capturedShapeId, localVertexIdx))"
                          @onpointerdown:stopPropagation="true">
                        <title>Drag to move this vertex</title>
                    </rect>
                }

                var edgeCount = s.CloseEdge ? s.Points.Count : s.Points.Count - 1;
                @for (int edgeIdx = 0; edgeIdx < edgeCount; edgeIdx++)
                {
                    var localEdgeIdx = edgeIdx;
                    var edgeStart = s.Points[localEdgeIdx];
                    var edgeEnd = s.Points[(localEdgeIdx + 1) % s.Points.Count];
                    var edgeBulge = s.EdgeBulges is not null && localEdgeIdx < s.EdgeBulges.Count
                        ? s.EdgeBulges[localEdgeIdx]
                        : 0;
                    var handle = EdgeArcGeometry.MidpointOnEdge(edgeStart, edgeEnd, edgeBulge);
                    <circle cx="@GardenPlot.F(handle.X)" cy="@GardenPlot.F(handle.Y)" r="0.1"
                            fill="#fffbe6" stroke="#b58105" stroke-width="0.04" cursor="ns-resize"
                            pointer-events="auto"
                            @onpointerdown="@(e => Parent!.OnEdgeBulgePointerDown(e, capturedShapeId, localEdgeIdx))"
                            @onpointerdown:stopPropagation="true">
                        <title>Drag to curve this side</title>
                    </circle>
                }
            }
        }
    </g>
}
