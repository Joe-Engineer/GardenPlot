    private static double EffectiveFontScale(Shape s)
    {
        var scale = s.FontScale ?? 1.0;
        if (double.IsNaN(scale) || double.IsInfinity(scale) || scale <= 0)
        {
            return 1.0;
        }

        return Math.Clamp(scale, 0.5, 3.0);
    }

