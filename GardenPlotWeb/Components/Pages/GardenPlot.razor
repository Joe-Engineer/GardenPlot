@page "/"
@page "/plot"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Diagnostics
@using System.Diagnostics.Metrics
@using System.Globalization
@using System.Net
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using GardenPlotWeb.Models
@using GardenPlotWeb.Services
@inject IJSRuntime JS
@inject IHttpClientFactory HttpFactory
@inject IWebHostEnvironment Env
@inject DataRootProvider DataRoot
@inject ILogger<GardenPlot> Logger

<PageTitle>Garden Plot</PageTitle>

<div class="d-flex align-items-center mb-2 gap-2 flex-wrap">
    <h1 class="mb-0 me-2">Garden Plot</h1>
    @if (currentPlot is not null)
    {
        <select class="form-select form-select-sm w-auto" value="@currentPlot.Id"
                @onchange="OnPlotChanged">
            @foreach (var p in library.Plots)
            {
                <option value="@p.Id">@p.Name (@F(p.WidthFt)' × @F(p.HeightFt)')</option>
            }
        </select>
    }
    <button class="btn btn-sm btn-outline-success" @onclick="ShowNewPlotDialog">+ New Plot</button>
    @if (currentPlot is not null)
    {
        <button class="btn btn-sm btn-outline-secondary" @onclick="ShowEditPlotDialog">Edit Plot</button>
    }
    @if (currentPlot is not null && library.Plots.Count > 1)
    {
        <button class="btn btn-sm btn-outline-danger" @onclick="DeleteCurrentPlot">Delete Plot</button>
    }
    <a href="/about" class="ms-auto text-nowrap">Help / About</a>
</div>

@if (currentPlot is not null)
{
    <div class="text-muted small mb-2 plot-info-line">
        @F(currentPlot.WidthFt) ft × @F(currentPlot.HeightFt) ft &mdash; flat. Pick a tool, then draw or stamp on the plot.
    </div>
}

@if (currentPlot is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="plot-toolbar">
        <div class="toolbar-row toolbar-row-global">
            <div class="toolbar-group" role="toolbar" aria-label="Drawing tools">
                @foreach (var t in tools)
                {
                    <button class="toolbar-icon-btn @(currentTool == t.Value ? "active" : string.Empty)"
                            @onclick="() => SetTool(t.Value)" title="@t.Key" aria-label="@t.Key">
                        @switch (t.Value)
                        {
                            case Tool.Select:
                                <svg viewBox="0 0 24 24"><path d="M4 3L18 13L11 14L12 21L9 22L8 15L3 17Z" fill="currentColor" /></svg>
                                break;
                            case Tool.FreeDraw:
                                <svg viewBox="0 0 24 24"><path d="M4 17C7 14 9 9 14 7C16 6 18 7 19 9C20 11 19 13 17 14C12 17 9 20 4 17Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                                break;
                            case Tool.Rectangle:
                                <svg viewBox="0 0 24 24"><rect x="4" y="6" width="16" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                                break;
                            case Tool.Oval:
                                <svg viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="8" ry="5.5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                                break;
                            case Tool.Ruler:
                                <svg viewBox="0 0 24 24"><path d="M4 16L16 4L20 8L8 20L4 20Z" fill="none" stroke="currentColor" stroke-width="2" /><path d="M9 9L11 11M12 6L14 8M6 12L8 14" stroke="currentColor" stroke-width="1.5" /></svg>
                                break;
                            case Tool.CircleRuler:
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 12L19 12" stroke="currentColor" stroke-width="1.5" /></svg>
                                break;
                            case Tool.RectRuler:
                                <svg viewBox="0 0 24 24"><rect x="5" y="7" width="14" height="10" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 12L19 12" stroke="currentColor" stroke-width="1.5" /></svg>
                                break;
                        }
                    </button>
                }
            </div>

            <div class="toolbar-group zoom-group">
                <span class="small text-muted">Tool: <strong>@currentTool</strong></span>
                <span class="zoom-controls">
                    <button class="toolbar-icon-btn zoom-btn" @onclick="ZoomOut" title="Zoom out (−10%)" aria-label="Zoom out">
                        <svg viewBox="0 0 24 24"><path d="M6 12H18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><circle cx="11" cy="11" r="6" fill="none" stroke="currentColor" stroke-width="2" /><path d="M15.5 15.5L20 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    </button>
                    <input type="range" class="zoom-slider" min="@((int)(MinZoom*100))" max="@((int)(MaxZoom*100))" step="5"
                           value="@((int)Math.Round(zoom * 100))" @oninput="OnZoomSliderInput" />
                    <button class="toolbar-icon-btn zoom-btn" @onclick="ZoomIn" title="Zoom in (+10%)" aria-label="Zoom in">
                        <svg viewBox="0 0 24 24"><path d="M6 12H18M12 6V18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><circle cx="11" cy="11" r="6" fill="none" stroke="currentColor" stroke-width="2" /><path d="M15.5 15.5L20 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    </button>
                    <input type="text" class="zoom-input form-control form-control-sm" value="@zoomInputText"
                           @oninput="OnZoomTextInput" @onkeydown="OnZoomTextKey" @onblur="ApplyZoomFromText" />
                    <button class="btn btn-sm btn-link p-0 small" @onclick="ZoomReset" title="Reset zoom">reset</button>
                </span>
                <button class="toolbar-icon-btn" @onclick="ResetControls" title="Reset tool mode, zoom, and floating panel positions" aria-label="Reset controls">
                    <svg viewBox="0 0 24 24"><path d="M12 5a7 7 0 1 1-6.6 9.3" fill="none" stroke="currentColor" stroke-width="2" /><path d="M4 4V10H10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <button class="toolbar-icon-btn" @onclick="ClearAll" title="Clear all shapes" aria-label="Clear all">
                    <svg viewBox="0 0 24 24"><path d="M4 7H20" stroke="currentColor" stroke-width="2" /><path d="M9 7V5H15V7" stroke="currentColor" stroke-width="2" /><rect x="7" y="7" width="10" height="13" rx="1" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                </button>
            </div>
        </div>

        <div class="toolbar-row toolbar-row-context">
            <div class="toolbar-group" role="toolbar" aria-label="Selection actions">
                <button class="toolbar-icon-btn" @onclick="CopySelected" disabled="@(selectedIds.Count == 0)" title="Copy selection" aria-label="Copy selection">
                    <svg viewBox="0 0 24 24"><rect x="8" y="8" width="10" height="12" rx="1" fill="none" stroke="currentColor" stroke-width="2" /><rect x="5" y="4" width="10" height="12" rx="1" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                </button>
                <button class="toolbar-icon-btn" @onclick="PasteClipboard" disabled="@(!HasClipboard)" title="Paste" aria-label="Paste">
                    <svg viewBox="0 0 24 24"><path d="M8 4H16V7H19V20H5V7H8Z" fill="none" stroke="currentColor" stroke-width="2" /><path d="M10 3H14V6H10Z" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                </button>
                <button class="toolbar-icon-btn danger" @onclick="DeleteSelected" disabled="@(selectedIds.Count == 0)" title="Delete selection" aria-label="Delete selection">
                    <svg viewBox="0 0 24 24"><path d="M4 7H20" stroke="currentColor" stroke-width="2" /><path d="M9 7V5H15V7" stroke="currentColor" stroke-width="2" /><rect x="7" y="7" width="10" height="13" rx="1" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                </button>
                <button class="toolbar-icon-btn" @onclick="SendSelectionToBack" disabled="@(selectedIds.Count == 0)" title="Send selected items behind others" aria-label="Send to back">
                    <svg viewBox="0 0 24 24"><rect x="5" y="9" width="10" height="10" fill="#7f8790" /><rect x="9" y="5" width="10" height="10" fill="#bcc3ca" stroke="#5f666d" stroke-width="1" /></svg>
                </button>
                <button class="toolbar-icon-btn" @onclick="BringSelectionToFront" disabled="@(selectedIds.Count == 0)" title="Move selected items in front of others" aria-label="Bring to front">
                    <svg viewBox="0 0 24 24"><rect x="5" y="9" width="10" height="10" fill="#bcc3ca" stroke="#5f666d" stroke-width="1" /><rect x="9" y="5" width="10" height="10" fill="#7f8790" /></svg>
                </button>
                <button class="toolbar-icon-btn" @onclick="GroupSelectedItems" disabled="@(!CanGroupSelection)" title="Group selection" aria-label="Group selection">
                    <svg viewBox="0 0 24 24"><rect x="4" y="7" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.8" /><rect x="14" y="7" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.8" /><rect x="9" y="13" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M10 10H14M12 10V13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                </button>
                <button class="toolbar-icon-btn" @onclick="UngroupSelectedItems" disabled="@(!CanUngroupSelection)" title="Ungroup selection" aria-label="Ungroup selection">
                    <svg viewBox="0 0 24 24"><rect x="4" y="7" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.8" /><rect x="14" y="7" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.8" /><rect x="9" y="13" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M10 10H14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><path d="M12 12L12 12" stroke="currentColor" stroke-width="1.6" /></svg>
                </button>
            </div>

            <div class="align-toolbar align-toolbar-inline" role="toolbar" aria-label="Position controls">
                @if (selectedIds.Count >= 2)
                {
                    <span class="small text-muted me-2">@selectedIds.Count selected</span>
                    <button class="align-btn" title="Align Left" @onclick='() => AlignSelected("left")'>
                        <svg viewBox="0 0 24 24"><line x1="3" y1="2" x2="3" y2="22" stroke="#333" stroke-width="2"/><rect x="4" y="5" width="14" height="4" fill="#5a8a4a"/><rect x="4" y="13" width="9" height="4" fill="#5a8a4a"/></svg>
                    </button>
                    <button class="align-btn" title="Align Right" @onclick='() => AlignSelected("right")'>
                        <svg viewBox="0 0 24 24"><line x1="21" y1="2" x2="21" y2="22" stroke="#333" stroke-width="2"/><rect x="6" y="5" width="14" height="4" fill="#5a8a4a"/><rect x="11" y="13" width="9" height="4" fill="#5a8a4a"/></svg>
                    </button>
                    <button class="align-btn" title="Align Top" @onclick='() => AlignSelected("top")'>
                        <svg viewBox="0 0 24 24"><line x1="2" y1="3" x2="22" y2="3" stroke="#333" stroke-width="2"/><rect x="5" y="4" width="4" height="14" fill="#5a8a4a"/><rect x="13" y="4" width="4" height="9" fill="#5a8a4a"/></svg>
                    </button>
                    <button class="align-btn" title="Align Bottom" @onclick='() => AlignSelected("bottom")'>
                        <svg viewBox="0 0 24 24"><line x1="2" y1="21" x2="22" y2="21" stroke="#333" stroke-width="2"/><rect x="5" y="6" width="4" height="14" fill="#5a8a4a"/><rect x="13" y="11" width="4" height="9" fill="#5a8a4a"/></svg>
                    </button>
                    <span class="align-divider"></span>
                    <button class="align-btn" title="Distribute Horizontally (equal gaps)" disabled="@(selectedIds.Count < 3)" @onclick="() => DistributeSelected(true)">
                        <svg viewBox="0 0 24 24"><rect x="2" y="6" width="4" height="12" fill="#5a8a4a"/><rect x="10" y="6" width="4" height="12" fill="#5a8a4a"/><rect x="18" y="6" width="4" height="12" fill="#5a8a4a"/><line x1="6" y1="12" x2="10" y2="12" stroke="#999" stroke-width="1.2" stroke-dasharray="2,1"/><line x1="14" y1="12" x2="18" y2="12" stroke="#999" stroke-width="1.2" stroke-dasharray="2,1"/></svg>
                    </button>
                    <button class="align-btn" title="Distribute Vertically (equal gaps)" disabled="@(selectedIds.Count < 3)" @onclick="() => DistributeSelected(false)">
                        <svg viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="4" fill="#5a8a4a"/><rect x="6" y="10" width="12" height="4" fill="#5a8a4a"/><rect x="6" y="18" width="12" height="4" fill="#5a8a4a"/><line x1="12" y1="6" x2="12" y2="10" stroke="#999" stroke-width="1.2" stroke-dasharray="2,1"/><line x1="12" y1="14" x2="12" y2="18" stroke="#999" stroke-width="1.2" stroke-dasharray="2,1"/></svg>
                    </button>
                }
                else
                {
                    <span class="x-small text-muted">Select 2+ items for align/distribute</span>
                }
            </div>

            <span class="drop-controls">
            <label class="small text-muted">Drop</label>
            <div class="drop-field">
                <label class="drop-field-label">Qty</label>
                <input type="number" min="1" max="600" step="1" class="form-control form-control-sm drop-input" title="Items"
                       @bind="arrayDropCount" />
            </div>
            <div class="drop-field">
                <label class="drop-field-label">Rows</label>
                <input type="number" min="1" max="600" step="1" class="form-control form-control-sm drop-input" title="Rows"
                       @bind="arrayDropRows" />
            </div>
            <div class="drop-field">
                <label class="drop-field-label">X ft</label>
                <input type="number" min="0" max="100" step="0.1" class="form-control form-control-sm drop-input" title="Column center spacing (ft), 0 = item default"
                       @bind="arrayCenterSpacingXFt" />
            </div>
            <div class="drop-field">
                <label class="drop-field-label">Y ft</label>
                <input type="number" min="0" max="100" step="0.1" class="form-control form-control-sm drop-input" title="Row center spacing (ft), 0 = item default"
                       @bind="arrayCenterSpacingYFt" />
            </div>
            <label class="drop-check small"><input type="checkbox" @bind="arrayStaggerHalf" /> 1/2 stagger</label>
            </span>

            <span class="toolbar-group toolbar-group-right">
                <button class="toolbar-icon-btn" @onclick="ShowKeyBindingsDialog" title="Keyboard mappings" aria-label="Keyboard mappings">
                    <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M7 10H9M11 10H13M15 10H17M7 14H11M13 14H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                </button>
                <button class="toolbar-icon-btn" @onclick="ExportPng" title="Export the plot as a PNG image" aria-label="Export PNG">
                    <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M7 15L10 12L13 15L16 11L19 15" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="9" cy="8" r="1.4" fill="currentColor" /></svg>
                </button>
                <button class="toolbar-icon-btn" @onclick="PrintPlot" title="Open print preview (use 'Save as PDF' from the print dialog)" aria-label="Print or save PDF">
                    <svg viewBox="0 0 24 24"><rect x="6" y="4" width="12" height="6" fill="none" stroke="currentColor" stroke-width="2" /><rect x="5" y="10" width="14" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="2" /><rect x="7" y="14" width="10" height="6" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                </button>
            </span>
        </div>
    </div>

@if (showKeyBindingsDialog)
{
    var kb = library.Ui.KeyBindings;
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Keyboard mappings</h5>
                    <button type="button" class="btn-close" @onclick="CloseKeyBindingsDialog"></button>
                </div>
                <div class="modal-body keybind-modal-body">
                    <div class="x-small text-muted mb-2">Use combinations like <code>Ctrl+G</code>, <code>Alt+ArrowLeft</code>, or single keys like <code>Escape</code>.</div>
                    <div class="keybind-grid">
                        <label>Stamp spacing left</label><input class="form-control form-control-sm" @bind="kb.StampSpacingLeft" />
                        <label>Stamp spacing right</label><input class="form-control form-control-sm" @bind="kb.StampSpacingRight" />
                        <label>Stamp spacing up</label><input class="form-control form-control-sm" @bind="kb.StampSpacingUp" />
                        <label>Stamp spacing down</label><input class="form-control form-control-sm" @bind="kb.StampSpacingDown" />

                        <label>Undo</label><input class="form-control form-control-sm" @bind="kb.Undo" />
                        <label>Select all</label><input class="form-control form-control-sm" @bind="kb.SelectAll" />
                        <label>Copy</label><input class="form-control form-control-sm" @bind="kb.Copy" />
                        <label>Paste</label><input class="form-control form-control-sm" @bind="kb.Paste" />
                        <label>Delete</label><input class="form-control form-control-sm" @bind="kb.Delete" />
                        <label>Rotate counter-clockwise</label><input class="form-control form-control-sm" @bind="kb.RotateCounterClockwise" />
                        <label>Rotate clockwise</label><input class="form-control form-control-sm" @bind="kb.RotateClockwise" />
                        <label>Escape / cancel</label><input class="form-control form-control-sm" @bind="kb.Escape" />

                        <label>Group selection</label><input class="form-control form-control-sm" @bind="kb.Group" />
                        <label>Ungroup selection</label><input class="form-control form-control-sm" @bind="kb.Ungroup" />

                        <label>Zoom in</label><input class="form-control form-control-sm" @bind="kb.ZoomIn" />
                        <label>Zoom out</label><input class="form-control form-control-sm" @bind="kb.ZoomOut" />
                        <label>Zoom reset</label><input class="form-control form-control-sm" @bind="kb.ZoomReset" />

                        <label>Pan left</label><input class="form-control form-control-sm" @bind="kb.PanLeft" />
                        <label>Pan right</label><input class="form-control form-control-sm" @bind="kb.PanRight" />
                        <label>Pan up</label><input class="form-control form-control-sm" @bind="kb.PanUp" />
                        <label>Pan down</label><input class="form-control form-control-sm" @bind="kb.PanDown" />

                        <label>Group orientation CCW</label><input class="form-control form-control-sm" @bind="kb.RotateGroupOrientationCounterClockwise" />
                        <label>Group orientation CW</label><input class="form-control form-control-sm" @bind="kb.RotateGroupOrientationClockwise" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetDefaultKeyBindings">Reset defaults</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveAndCloseKeyBindingsDialog">Save</button>
                </div>
            </div>
        </div>
    </div>
}

    <div class="plot-workspace">
            <aside class="plot-palette">
                <div class="palette-header">
                    <select class="form-select form-select-sm palette-combobox"
                            value="@currentCategory"
                            @onchange="OnCategoryChanged">
                        @foreach (var cat in System.Enum.GetValues<PaletteCategory>())
                        {
                            <option value="@cat">@CategoryLabel(cat)</option>
                        }
                    </select>
                    @if (currentCategory == PaletteCategory.CustomTiles)
                    {
                        <button class="btn btn-sm btn-outline-primary palette-add-btn" @onclick="ShowAddCustomTileDialog">+ Add Item</button>
                    }
                </div>
                <div class="palette-grid">
                    @foreach (var item in PaletteItemsForCurrentCategory())
                    {
                        var isActive = selectedItem?.Code == item.Code;
                        var detail = item.Kind switch
                        {
                            PaletteKind.BedKit => $"{item.WidthFt}'×{item.HeightFt}' · {item.Pieces} pcs",
                            PaletteKind.Plant  => $"spacing {FormatPlantSpacing(item.WidthFt)} · {item.Sunlight} · {item.Water} water",
                            PaletteKind.CustomTile => $"{item.StampShapeKind ?? ShapeKind.Rectangle} · {item.WidthFt}'×{item.HeightFt}'",
                            _                  => $"{item.WidthFt}' Ø · {item.Trait}",
                        };
                        <button class="palette-item @(isActive ? "active" : "")"
                                @onclick="() => SelectItem(item)" title="@item.Code — @detail">
                                @if (!string.IsNullOrWhiteSpace(item.TilePreviewImageFileName))
                                {
                                    <img class="palette-item-image" src="@TileImageUrl(item.TilePreviewImageFileName!)" alt="" />
                                }
                                else
                                {
                                    <svg viewBox="@PreviewViewBox(item)" preserveAspectRatio="xMidYMid meet">
                                        @switch (item.Kind)
                                        {
                                            case PaletteKind.BedKit:
                                                <rect x="0" y="0" width="@F(item.WidthFt)" height="@F(item.HeightFt)"
                                                      rx="@F(Math.Min(item.WidthFt, item.HeightFt) / 3.0)"
                                                      ry="@F(Math.Min(item.WidthFt, item.HeightFt) / 3.0)"
                                                      fill="#e2725b" fill-opacity="0.5" stroke="#7a3520" stroke-width="0.15" />
                                                break;
                                            case PaletteKind.Tree:
                                                @((MarkupString)PlantRendering.TreeSvg(0, 0, item.WidthFt, item.HeightFt, item.Trait))
                                                break;
                                            case PaletteKind.Bush:
                                                @((MarkupString)PlantRendering.BushSvg(0, 0, item.WidthFt, item.HeightFt, item.Trait))
                                                break;
                                            case PaletteKind.Plant:
                                                @((MarkupString)PlantRendering.SpacingRingsSvg(item.WidthFt / 2, item.HeightFt / 2, item.WidthFt, "good"))
                                                @((MarkupString)PlantRendering.PlantSpriteSvg(item.WidthFt / 2, item.HeightFt / 2, item.WidthFt, item.Trait))
                                                break;
                                            case PaletteKind.CustomTile:
                                                if (item.StampShapeKind == ShapeKind.Oval)
                                                {
                                                    <ellipse cx="@F(item.WidthFt / 2)" cy="@F(item.HeightFt / 2)"
                                                             rx="@F(item.WidthFt / 2)" ry="@F(item.HeightFt / 2)"
                                                             fill="@(item.FillColor ?? "#e2725b")" fill-opacity="0.65"
                                                             stroke="@(item.StrokeColor ?? "#7a3520")" stroke-width="0.12" />
                                                }
                                                else
                                                {
                                                    <rect x="0" y="0" width="@F(item.WidthFt)" height="@F(item.HeightFt)"
                                                          fill="@(item.FillColor ?? "#e2725b")" fill-opacity="0.65"
                                                          stroke="@(item.StrokeColor ?? "#7a3520")" stroke-width="0.12" />
                                                }
                                                break;
                                        }
                                    </svg>
                                }
                                <div class="small palette-item-name">@item.Code</div>
                                <div class="x-small text-muted">@detail</div>
                        </button>
                    }
                </div>
                @if (currentCategory == PaletteCategory.CustomTiles)
                {
                    <div class="palette-footer">
                        <button class="btn btn-sm btn-outline-secondary w-100"
                                @onclick="ShowEditSelectedCustomTileDialog"
                                disabled="@(selectedItem?.Kind != PaletteKind.CustomTile)">Edit Item</button>
                    </div>
                }
            </aside>

            <div class="plot-viewport-frame">
            <div class="plot-scroll-view" @ref="wrapRef">
            <div class="plot-canvas-wrap">
                <svg class="plot-canvas @(showCanvasScalePanel ? "scale-capture-active" : string.Empty)"
                     @ref="canvasRef"
                     tabindex="0"
                     style="width:@(PlotWidthFt * PxPerFt * zoom)px; height:@(PlotHeightFt * PxPerFt * zoom)px;"
                     viewBox="0 0 @F(PlotWidthFt) @F(PlotHeightFt)"
                     preserveAspectRatio="xMidYMid meet"
                     @onkeydown="OnKeyDown"
                     @onkeydown:preventDefault="true"
                     @oncontextmenu="OnCanvasContextMenu"
                     @oncontextmenu:preventDefault="true"
                     @onpointerdown="OnPointerDown"
                     @onpointermove="OnPointerMove"
                     @onpointerup="OnPointerUp"
                     @onpointerleave="OnPointerLeave"
                     @onpointerdown:preventDefault="true">

                <defs>
                    @if (currentPlot.ShowGrid)
                    {
                        <pattern id="ftgrid" width="1" height="1" patternUnits="userSpaceOnUse">
                            <path d="M 1 0 L 0 0 0 1"
                                  fill="none"
                                  stroke="@EffectivePlotGridColor(currentPlot)"
                                  stroke-width="@F(EffectivePlotGridLineWidth(currentPlot))"
                                  stroke-opacity="@F(EffectivePlotGridOpacity(currentPlot))" />
                        </pattern>
                    }
                </defs>

                <rect x="0" y="0" width="@F(PlotWidthFt)" height="@F(PlotHeightFt)" fill="#f3efe3" />
                @if (!string.IsNullOrWhiteSpace(currentPlot.BackgroundImageFileName))
                {
                    <image href="@PlotImageUrl(currentPlot.BackgroundImageFileName!)"
                           x="0" y="0" width="@F(PlotWidthFt)" height="@F(PlotHeightFt)"
                           preserveAspectRatio="none"
                           opacity="@F(EffectivePlotBackgroundOpacity(currentPlot))" />
                }
                @if (currentPlot.ShowGrid)
                {
                    <rect x="0" y="0" width="@F(PlotWidthFt)" height="@F(PlotHeightFt)" fill="url(#ftgrid)" />
                }
                <rect x="0" y="0" width="@F(PlotWidthFt)" height="@F(PlotHeightFt)" fill="none"
                      stroke="#7a6a4a" stroke-width="0.05" />

                @if (showCanvasScalePanel && canvasScaleStartXFt is double sx && canvasScaleStartYFt is double sy)
                {
                    var tx = canvasScaleEndXFt ?? canvasScaleCurrentXFt ?? sx;
                    var ty = canvasScaleEndYFt ?? canvasScaleCurrentYFt ?? sy;
                    var mx = (sx + tx) / 2;
                    var my = (sy + ty) / 2;
                    var md = Math.Sqrt(Math.Pow(tx - sx, 2) + Math.Pow(ty - sy, 2));
                    <g class="canvas-scale-preview" pointer-events="none">
                        <line x1="@F(sx)" y1="@F(sy)" x2="@F(tx)" y2="@F(ty)" stroke="#c81e1e" stroke-width="0.08" stroke-dasharray="0.2,0.1" />
                        <circle cx="@F(sx)" cy="@F(sy)" r="0.12" fill="#fff" stroke="#c81e1e" stroke-width="0.05" />
                        <circle cx="@F(tx)" cy="@F(ty)" r="0.12" fill="#fff" stroke="#c81e1e" stroke-width="0.05" />
                        @SvgScalePreviewLabel(mx, my - 0.2, $"{F(md)} ft")
                    </g>
                }

                @{
                    // Plant spacing overlay (under shapes): one set of rings per plant, color-coded by overlap.
                    var plantList = currentPlot.Shapes.Where(z => z.Kind == ShapeKind.Plant).ToList();
                }
                @if (plantList.Count > 0)
                {
                    <g pointer-events="none">
                        @foreach (var p in plantList)
                        {
                            var status = ComputeSpacingStatus(p, plantList);
                            var pcx = p.X + p.W / 2;
                            var pcy = p.Y + p.H / 2;
                            @((MarkupString)PlantRendering.SpacingRingsSvg(pcx, pcy, p.W, status))
                        }
                    </g>
                }

                @foreach (var s in currentPlot.Shapes)
                {
                    var sb = GetBounds(s);
                    var scx = sb.x + sb.w / 2;
                    var scy = sb.y + sb.h / 2;
                    <g class="shape @(IsSelected(s.Id) ? "selected" : "")"
                       transform="rotate(@F(s.Rotation) @F(scx) @F(scy))"
                       pointer-events="@(currentTool == Tool.Select ? "auto" : "none")"
                       @onpointerdown="(e) => OnShapePointerDown(e, s)"
                       @onpointerdown:stopPropagation="true"
                       @oncontextmenu="(e) => OnShapeContextMenu(e, s)"
                       @oncontextmenu:preventDefault="true"
                       @oncontextmenu:stopPropagation="true">
                        @switch (s.Kind)
                        {
                            case ShapeKind.Rectangle:
                                var rectClipId = $"tile-clip-{s.Id:N}";
                                <rect x="@F(s.X)" y="@F(s.Y)" width="@F(s.W)" height="@F(s.H)"
                                      fill="@EffectiveFill(s)" fill-opacity="@F(EffectiveFillOpacity(s))"
                                      stroke="@EffectiveStroke(s)" stroke-width="0.06" />
                                @if (!string.IsNullOrWhiteSpace(s.TileBackgroundImageFileName))
                                {
                                    <clipPath id="@rectClipId">
                                        <rect x="@F(s.X)" y="@F(s.Y)" width="@F(s.W)" height="@F(s.H)" />
                                    </clipPath>
                                    <image href="@TileImageUrl(s.TileBackgroundImageFileName!)"
                                           x="@F(s.X)" y="@F(s.Y)" width="@F(s.W)" height="@F(s.H)"
                                           preserveAspectRatio="xMidYMid slice"
                                           clip-path="url(#@rectClipId)" />
                                }
                                break;
                            case ShapeKind.Oval:
                                var ovalClipId = $"tile-clip-{s.Id:N}";
                                <ellipse cx="@F(s.X + s.W / 2)" cy="@F(s.Y + s.H / 2)"
                                         rx="@F(s.W / 2)" ry="@F(s.H / 2)"
                                         fill="@EffectiveFill(s)" fill-opacity="@F(EffectiveFillOpacity(s))"
                                         stroke="@EffectiveStroke(s)" stroke-width="0.06" />
                                @if (!string.IsNullOrWhiteSpace(s.TileBackgroundImageFileName))
                                {
                                    <clipPath id="@ovalClipId">
                                        <ellipse cx="@F(s.X + s.W / 2)" cy="@F(s.Y + s.H / 2)"
                                                 rx="@F(s.W / 2)" ry="@F(s.H / 2)" />
                                    </clipPath>
                                    <image href="@TileImageUrl(s.TileBackgroundImageFileName!)"
                                           x="@F(s.X)" y="@F(s.Y)" width="@F(s.W)" height="@F(s.H)"
                                           preserveAspectRatio="xMidYMid slice"
                                           clip-path="url(#@ovalClipId)" />
                                }
                                break;
                            case ShapeKind.FreeDraw:
                                <polyline points="@PointsString(s.Points)"
                                          fill="none" stroke="@EffectiveStroke(s)" stroke-width="0.08"
                                          stroke-linecap="round" stroke-linejoin="round" />
                                <rect x="@F(sb.x - 0.1)" y="@F(sb.y - 0.1)"
                                      width="@F(sb.w + 0.2)" height="@F(sb.h + 0.2)"
                                      fill="transparent" stroke="none" />
                                break;
                            case ShapeKind.CircleRuler:
                                <circle cx="@F(s.X + (s.W / 2))" cy="@F(s.Y + (s.H / 2))" r="@F(s.W / 2)"
                                        fill="@EffectiveFill(s)" fill-opacity="@F(EffectiveFillOpacity(s))"
                                        stroke="@EffectiveStroke(s)" stroke-width="0.06" />
                                @((MarkupString)CircleRulerLabelsSvg(s))
                                @if (currentTool == Tool.Select)
                                {
                                    @((MarkupString)CircleRulerGrabbersSvg(s, IsSelected(s.Id)))
                                }
                                break;
                            case ShapeKind.RectRuler:
                                <rect x="@F(s.X)" y="@F(s.Y)" width="@F(s.W)" height="@F(s.H)"
                                      fill="@EffectiveFill(s)" fill-opacity="@F(EffectiveFillOpacity(s))"
                                      stroke="@EffectiveStroke(s)" stroke-width="0.06" />
                                @((MarkupString)RectRulerLabelsSvg(s))
                                @if (currentTool == Tool.Select)
                                {
                                    @((MarkupString)RectRulerGrabbersSvg(s, IsSelected(s.Id)))
                                }
                                break;
                            case ShapeKind.Ruler:
                                <polyline points="@PointsString(s.Points)"
                                          fill="none" stroke="@EffectiveStroke(s)" stroke-width="0.06"
                                          stroke-linecap="round" stroke-linejoin="round" />
                                @foreach (var p in s.Points)
                                {
                                    <circle cx="@F(p.X)" cy="@F(p.Y)" r="0.08"
                                            fill="#fff" stroke="@EffectiveStroke(s)" stroke-width="0.04" />
                                }
                                @((MarkupString)RulerLabelsSvg(s))
                                <rect x="@F(sb.x - 0.1)" y="@F(sb.y - 0.1)"
                                      width="@F(sb.w + 0.2)" height="@F(sb.h + 0.2)"
                                      fill="transparent" stroke="none" />
                                break;
                            case ShapeKind.BedKit:
                                <g transform="translate(@F(s.X) @F(s.Y))">
                                    <rect x="0" y="0" width="@F(s.W)" height="@F(s.H)"
                                          rx="@F(Math.Min(s.W, s.H) / 3.0)"
                                          ry="@F(Math.Min(s.W, s.H) / 3.0)"
                                          fill="@EffectiveFill(s)" fill-opacity="@F(EffectiveFillOpacity(s))"
                                          stroke="@EffectiveStroke(s)" stroke-width="0.08" />
                                    <text x="@F(s.W / 2)" y="@F(s.H / 2)"
                                          text-anchor="middle" dominant-baseline="middle"
                                          font-size="@F((Math.Min(s.W, s.H) * 0.18) * EffectiveFontScale(s))" fill="#3d1c10"
                                          style="font-family: sans-serif; pointer-events:none;">@s.Label</text>
                                </g>
                                break;
                            case ShapeKind.Tree:
                                @((MarkupString)PlantRendering.TreeSvg(s.X, s.Y, s.W, s.H, s.Trait, s.Label))
                                break;
                            case ShapeKind.Bush:
                                @((MarkupString)PlantRendering.BushSvg(s.X, s.Y, s.W, s.H, s.Trait, s.Label))
                                break;
                            case ShapeKind.Plant:
                                @((MarkupString)PlantRendering.PlantSpriteSvg(s.X + s.W / 2, s.Y + s.H / 2, s.W, s.Trait))
                                break;
                        }
                        @if (IsSelected(s.Id))
                        {
                            <rect x="@F(sb.x - 0.05)" y="@F(sb.y - 0.05)"
                                  width="@F(sb.w + 0.1)" height="@F(sb.h + 0.1)"
                                  fill="none" stroke="#0d6efd" stroke-width="0.05"
                                  stroke-dasharray="0.15,0.1" pointer-events="none" />
                        }
                    </g>
                }

                @if (drafting is not null)
                {
                    @switch (drafting.Kind)
                    {
                        case ShapeKind.Rectangle:
                            <rect x="@F(drafting.X)" y="@F(drafting.Y)" width="@F(drafting.W)" height="@F(drafting.H)"
                                  fill="rgba(74,124,89,0.2)" stroke="#2f5a3a" stroke-width="0.06"
                                  stroke-dasharray="0.2,0.1" pointer-events="none" />
                            break;
                        case ShapeKind.Oval:
                            <ellipse cx="@F(drafting.X + drafting.W / 2)" cy="@F(drafting.Y + drafting.H / 2)"
                                     rx="@F(Math.Abs(drafting.W) / 2)" ry="@F(Math.Abs(drafting.H) / 2)"
                                     fill="rgba(74,124,89,0.2)" stroke="#2f5a3a" stroke-width="0.06"
                                     stroke-dasharray="0.2,0.1" pointer-events="none" />
                            break;
                        case ShapeKind.FreeDraw:
                            <polyline points="@PointsString(drafting.Points)"
                                      fill="none" stroke="#3a3a3a" stroke-width="0.08"
                                      stroke-linecap="round" stroke-linejoin="round" pointer-events="none" />
                            break;
                        case ShapeKind.Ruler:
                            <polyline points="@PointsString(drafting.Points)"
                                      fill="none" stroke="#c81e1e" stroke-width="0.06"
                                      stroke-linecap="round" stroke-linejoin="round"
                                      stroke-dasharray="0.2,0.1" pointer-events="none" />
                            @foreach (var p in drafting.Points)
                            {
                                <circle cx="@F(p.X)" cy="@F(p.Y)" r="0.08"
                                        fill="#fff" stroke="#c81e1e" stroke-width="0.04" pointer-events="none" />
                            }
                            @((MarkupString)RulerLabelsSvg(drafting))
                            break;
                        case ShapeKind.CircleRuler:
                            <circle cx="@F(drafting.X + (drafting.W / 2))" cy="@F(drafting.Y + (drafting.H / 2))" r="@F(drafting.W / 2)"
                                    fill="none" stroke="#c81e1e" stroke-width="0.06"
                                    stroke-dasharray="0.2,0.1" pointer-events="none" />
                            @((MarkupString)CircleRulerLabelsSvg(drafting))
                            break;
                        case ShapeKind.RectRuler:
                            <rect x="@F(drafting.X)" y="@F(drafting.Y)" width="@F(drafting.W)" height="@F(drafting.H)"
                                  fill="none" stroke="#c81e1e" stroke-width="0.06"
                                  stroke-dasharray="0.2,0.1" pointer-events="none" />
                            @((MarkupString)RectRulerLabelsSvg(drafting))
                            break;
                    }
                }
                @if (currentTool == Tool.Select && isBoxSelecting)
                {
                    var bx = Math.Min(boxSelectStartX, boxSelectCurrentX);
                    var by = Math.Min(boxSelectStartY, boxSelectCurrentY);
                    var bw = Math.Abs(boxSelectCurrentX - boxSelectStartX);
                    var bh = Math.Abs(boxSelectCurrentY - boxSelectStartY);
                    <rect x="@F(bx)" y="@F(by)" width="@F(bw)" height="@F(bh)"
                          fill="rgba(13,110,253,0.12)" stroke="#0d6efd" stroke-width="0.05"
                          stroke-dasharray="0.15,0.1" pointer-events="none" />
                }

                @if (currentTool == Tool.Select && isPasteMode && pasteHoverX is { } phx && pasteHoverY is { } phy && clipboard.Count > 0)
                {
                    var previewShapes = BuildClipboardShapesAt(phx, phy, assignNewIds: false);
                    <g pointer-events="none" opacity="0.45">
                        @foreach (var s in previewShapes)
                        {
                            var sb = GetBounds(s);
                            var scx = sb.x + sb.w / 2;
                            var scy = sb.y + sb.h / 2;
                            <g transform="rotate(@F(s.Rotation) @F(scx) @F(scy))">
                                @switch (s.Kind)
                                {
                                    case ShapeKind.Rectangle:
                                        <rect x="@F(s.X)" y="@F(s.Y)" width="@F(s.W)" height="@F(s.H)"
                                              fill="@EffectiveFill(s)" fill-opacity="@F(EffectiveFillOpacity(s))"
                                              stroke="@EffectiveStroke(s)" stroke-width="0.06" stroke-dasharray="0.12,0.08" />
                                        break;
                                    case ShapeKind.Oval:
                                        <ellipse cx="@F(s.X + s.W / 2)" cy="@F(s.Y + s.H / 2)"
                                                 rx="@F(s.W / 2)" ry="@F(s.H / 2)"
                                                 fill="@EffectiveFill(s)" fill-opacity="@F(EffectiveFillOpacity(s))"
                                                 stroke="@EffectiveStroke(s)" stroke-width="0.06" stroke-dasharray="0.12,0.08" />
                                        break;
                                    case ShapeKind.FreeDraw:
                                        <polyline points="@PointsString(s.Points)"
                                                  fill="none" stroke="@EffectiveStroke(s)" stroke-width="0.08"
                                                  stroke-linecap="round" stroke-linejoin="round"
                                                  stroke-dasharray="0.12,0.08" />
                                        break;
                                    case ShapeKind.Ruler:
                                        <polyline points="@PointsString(s.Points)"
                                                  fill="none" stroke="@EffectiveStroke(s)" stroke-width="0.06"
                                                  stroke-linecap="round" stroke-linejoin="round"
                                                  stroke-dasharray="0.12,0.08" />
                                        @foreach (var p in s.Points)
                                        {
                                            <circle cx="@F(p.X)" cy="@F(p.Y)" r="0.08"
                                                    fill="#fff" stroke="@EffectiveStroke(s)" stroke-width="0.04" />
                                        }
                                        break;
                                    case ShapeKind.CircleRuler:
                                        <circle cx="@F(s.X + (s.W / 2))" cy="@F(s.Y + (s.H / 2))" r="@F(s.W / 2)"
                                                fill="@EffectiveFill(s)" fill-opacity="@F(EffectiveFillOpacity(s))"
                                                stroke="@EffectiveStroke(s)" stroke-width="0.06"
                                                stroke-dasharray="0.12,0.08" />
                                        break;
                                    case ShapeKind.RectRuler:
                                        <rect x="@F(s.X)" y="@F(s.Y)" width="@F(s.W)" height="@F(s.H)"
                                              fill="@EffectiveFill(s)" fill-opacity="@F(EffectiveFillOpacity(s))"
                                              stroke="@EffectiveStroke(s)" stroke-width="0.06"
                                              stroke-dasharray="0.12,0.08" />
                                        break;
                                    case ShapeKind.BedKit:
                                        @((MarkupString)BedKitGhostSvg(s.X, s.Y, s.W, s.H, s.Label ?? string.Empty))
                                        break;
                                    case ShapeKind.Tree:
                                        @((MarkupString)PlantRendering.TreeSvg(s.X, s.Y, s.W, s.H, s.Trait, s.Label))
                                        break;
                                    case ShapeKind.Bush:
                                        @((MarkupString)PlantRendering.BushSvg(s.X, s.Y, s.W, s.H, s.Trait, s.Label))
                                        break;
                                    case ShapeKind.Plant:
                                        @((MarkupString)PlantRendering.SpacingRingsSvg(s.X + s.W / 2, s.Y + s.H / 2, s.W, "good"))
                                        @((MarkupString)PlantRendering.PlantSpriteSvg(s.X + s.W / 2, s.Y + s.H / 2, s.W, s.Trait))
                                        break;
                                }
                            </g>
                        }
                    </g>
                }

                @if (currentTool == Tool.Stamp && selectedItem is { } gk && ghostX is { } gx && ghostY is { } gy)
                {
                    var previewPattern = ActiveDropPattern(pointerShiftDown, pointerCtrlDown, pointerAltDown);
                    var previewPlacement = BuildStampPlacement(gk, gx, gy, previewPattern, assignNewIds: false);
                    <g pointer-events="none" opacity="0.55">
                        @foreach (var s in previewPlacement.Shapes)
                        {
                            var sb = GetBounds(s);
                            var scx = sb.x + sb.w / 2;
                            var scy = sb.y + sb.h / 2;
                            <g transform="rotate(@F(s.Rotation) @F(scx) @F(scy))">
                                @switch (s.Kind)
                                {
                                    case ShapeKind.BedKit:
                                        @((MarkupString)BedKitGhostSvg(s.X, s.Y, s.W, s.H, s.Label ?? string.Empty))
                                        break;
                                    case ShapeKind.Tree:
                                        @((MarkupString)PlantRendering.TreeSvg(s.X, s.Y, s.W, s.H, s.Trait, s.Label))
                                        break;
                                    case ShapeKind.Bush:
                                        @((MarkupString)PlantRendering.BushSvg(s.X, s.Y, s.W, s.H, s.Trait, s.Label))
                                        break;
                                    case ShapeKind.Plant:
                                        @((MarkupString)PlantRendering.SpacingRingsSvg(s.X + s.W / 2, s.Y + s.H / 2, s.W, "good"))
                                        @((MarkupString)PlantRendering.PlantSpriteSvg(s.X + s.W / 2, s.Y + s.H / 2, s.W, s.Trait))
                                        break;
                                }
                            </g>
                        }
                    </g>
                }
                </svg>
            </div>
        </div>
            <div class="plot-status-bar" role="status" aria-live="polite">
                <span class="status-item status-pos"><strong>X:</strong> @(lastCanvasX is double statusX ? F(statusX) : "--")</span>
                <span class="status-item status-pos"><strong>Y:</strong> @(lastCanvasY is double statusY ? F(statusY) : "--")</span>
                <span class="status-item"><strong>Action:</strong> @CurrentMouseActionLabel()</span>
                <span class="status-item ms-auto">
                    <button class="btn btn-sm btn-link p-0 takeoff-toggle-btn"
                            @onclick="ToggleTakeoffPanel">
                        @(showTakeoffPanel ? "Hide Takeoff" : "Show Takeoff")
                    </button>
                </span>
            </div>
            <div class="view-scale-controls">
                <button class="btn btn-sm scale-icon-btn"
                        @onclick="BeginCanvasScaleCalibration"
                        disabled="@string.IsNullOrWhiteSpace(currentPlot.BackgroundImageFileName)"
                        title="Scale the current drawing"
                        aria-label="Scale the current drawing">📐</button>

                @if (currentPlot.ShowScaleDisplay)
                {
                    var pxPerFtNow = PxPerFt * zoom;
                    var scaleLenFt = NiceScaleLengthFt(pxPerFtNow, maxPx: 180);
                    var scaleLenPx = scaleLenFt * pxPerFtNow;
                    var overlayWidth = scaleLenPx + 24;
                    <div class="scale-indicator-overlay" style="width:@(F(overlayWidth))px;">
                        <svg viewBox="@($"0 0 {F(overlayWidth)} 30")" preserveAspectRatio="none" aria-label="Scale indicator">
                            <rect x="0.5" y="0.5" width="@F(overlayWidth - 1)" height="29" rx="4" ry="4" fill="rgba(255,255,255,0.92)" stroke="#b8c8a3" />
                            <line x1="12" y1="20" x2="@F(12 + scaleLenPx)" y2="20" stroke="#2f5a3a" stroke-width="1.6" />
                            @{
                                var tickStep = NiceTickStepFt(scaleLenFt);
                                var tickCount = (int)Math.Round(scaleLenFt / tickStep);
                            }
                            @for (var tick = 0; tick <= tickCount; tick++)
                            {
                                var ftAtTick = tick * tickStep;
                                var x = 12 + (ftAtTick * pxPerFtNow);
                                var major = tick == 0 || tick == tickCount || (tick % 5 == 0);
                                <line x1="@F(x)" y1="@(major ? "9" : "13")" x2="@F(x)" y2="21" stroke="#2f5a3a" stroke-width="1" />
                                if (major)
                                {
                                    @SvgOverlayScaleText(x, 8, ftAtTick.ToString(tickStep < 1 ? "0.##" : "0", CultureInfo.InvariantCulture))
                                }
                            }
                            @SvgOverlayScaleText(overlayWidth / 2, 28, $"Scale ({CurrentScaleUnitLabel()})")
                        </svg>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (showShapeContextMenu)
    {
        <div class="shape-context-menu" style="left:@F(shapeContextMenuX)px;top:@F(shapeContextMenuY)px;"
             @onpointerdown:stopPropagation="true">
            <button type="button" @onclick="BringSelectionToFrontFromMenu">Bring to Front</button>
            <button type="button" @onclick="SendSelectionToBackFromMenu">Send to Back</button>
        </div>
    }

@if (showCanvasScalePanel && currentPlot is not null)
{
    <div class="floating-panel scale-panel anchored-scale-pos">
        <div class="panel-header">
            <span class="panel-title">Scale calibration</span>
            <button type="button" class="btn-close btn-close-sm" @onclick="CloseCanvasScaleCalibration"></button>
        </div>
        <div class="panel-body">
            @if (canvasScaleStartXFt is null)
            {
                <div class="small">Click the first point</div>
            }
            else if (canvasScaleEndXFt is null)
            {
                <div class="small">Click the second point</div>
            }
            else
            {
                <div class="small mb-1">Enter the distance</div>
                <div class="row g-2 mb-1">
                    <div class="col-6">
                        <input type="number" min="0.1" max="1000000" step="0.1" class="form-control form-control-sm" @bind="canvasScaleKnownDistanceValue" />
                    </div>
                    <div class="col-6">
                        <select class="form-select form-select-sm" @bind="canvasScaleKnownDistanceUnit">
                            <option value="Feet">Feet</option>
                            <option value="Yards">Yards</option>
                            <option value="Miles">Miles</option>
                            <option value="Meters">Meters</option>
                            <option value="Kilometers">Kilometers</option>
                        </select>
                    </div>
                </div>
                <button class="btn btn-sm btn-primary" @onclick="SetCanvasScaleCalibrationAsync">Set</button>
            }

            @if (!string.IsNullOrWhiteSpace(canvasScaleStatus))
            {
                <div class="x-small text-muted mt-2">@canvasScaleStatus</div>
            }
            @if (!string.IsNullOrWhiteSpace(canvasScaleError))
            {
                <div class="x-small text-danger mt-1">@canvasScaleError</div>
            }
        </div>
    </div>
}
}

@if (currentPlot is not null)
{
    var takeoff = BuildTakeoff(currentPlot.Shapes);
    var totalCount = takeoff.Sum(t => t.Count);

    @if (showTakeoffPanel)
    {
        var positioned = library.Ui.TakeoffPanelX is double && library.Ui.TakeoffPanelY is double;
        <div class="floating-panel takeoff-floating @(positioned ? "" : "default-takeoff-pos")"
             @ref="takeoffPanelRef"
             style="@(positioned ? $"left:{library.Ui.TakeoffPanelX!.Value}px;top:{library.Ui.TakeoffPanelY!.Value}px;" : "")"
             @onpointermove="OnPanelDragMove"
             @onpointerup="OnPanelDragEnd"
             @onpointercancel="OnPanelDragEnd">
            <div class="panel-header"
                 @onpointerdown="StartTakeoffPanelDrag">
                <span class="panel-title">
                    Takeoff list
                    <span class="text-muted small ms-2">@takeoff.Count distinct · @totalCount placed</span>
                </span>
                <span class="d-flex align-items-center gap-1">
                    <button type="button" class="btn-close btn-close-sm" title="Hide Takeoff" aria-label="Hide Takeoff"
                            @onclick="HideTakeoffPanel"
                            @onpointerdown:stopPropagation="true"></button>
                </span>
            </div>
            <div class="panel-body takeoff-floating-body">
                @if (takeoff.Count == 0)
                {
                    <div class="x-small text-muted">Nothing placed yet.</div>
                }
                else
                {
                    <div class="d-flex justify-content-end mb-1">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ExportTakeoffCsv" title="Download as CSV">
                            Download CSV
                        </button>
                    </div>
                    <table class="table table-sm takeoff-table mb-0">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Name</th>
                                <th class="text-end">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in takeoff)
                            {
                                <tr>
                                    <td>@row.Kind</td>
                                    <td>@row.Name</td>
                                    <td class="text-end">@row.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}

@{
    var infoRuler = drafting is not null && IsRulerShape(drafting)
        ? drafting
        : (currentPlot is not null && PrimarySelectedId is { } sid
            ? currentPlot.Shapes.FirstOrDefault(z => z.Id == sid && IsRulerShape(z))
            : null);
    var primaryShape = currentPlot is not null && PrimarySelectedId is { } pid
        ? currentPlot.Shapes.FirstOrDefault(z => z.Id == pid)
        : null;
}

@if ((selectedIds.Count > 0 || (currentTool == Tool.Stamp && selectedItem is not null) || infoRuler is not null) && currentPlot is not null)
{
    var forceRulerMode = infoRuler is not null && (drafting is not null || selectedIds.Count <= 1);
    var stampPreview = (!forceRulerMode && selectedIds.Count == 0 && currentTool == Tool.Stamp && selectedItem is not null)
        ? PreviewShapeFromItem(selectedItem)
        : null;
    var isPreview = stampPreview is not null;
    var selShapes = forceRulerMode
        ? new List<Shape> { infoRuler! }
        : stampPreview is not null
        ? new List<Shape> { stampPreview }
        : SelectedShapes().ToList();
    var positioned = library.Ui.InfoPanelX is double && library.Ui.InfoPanelY is double;
    var isSingle = selShapes.Count == 1;
    var single = isSingle ? selShapes[0] : null;
    var customizable = isPreview ? new List<Shape>() : selShapes.Where(IsColorCustomizable).ToList();
    var fontCustomizable = isPreview ? new List<Shape>() : selShapes.Where(IsFontCustomizable).ToList();
    var strokeSet = customizable.Select(EffectiveStroke).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    var fillSet   = customizable.Select(EffectiveFill).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    var opSet     = customizable.Select(EffectiveFillOpacity).Distinct().ToList();
    var fontSet   = fontCustomizable.Select(EffectiveFontScale).Distinct().ToList();
    var strokeMixed = strokeSet.Count > 1;
    var fillMixed   = fillSet.Count > 1;
    var opMixed     = opSet.Count > 1;
    var fontMixed   = fontSet.Count > 1;
    var strokeValue = strokeMixed ? "#808080" : (strokeSet.Count == 1 ? strokeSet[0] : "#000000");
    var fillValue   = fillMixed   ? "#808080" : (fillSet.Count == 1   ? fillSet[0]   : "#000000");
    var opValue     = opMixed     ? 0.5       : (opSet.Count == 1     ? opSet[0]     : 1.0);
    var fontValue   = fontMixed   ? 1.0       : (fontSet.Count == 1   ? fontSet[0]   : 1.0);
    var selectedDropGroup = isPreview ? null : GetCurrentSelectedDropGroup();
    var previewDropPattern = isPreview ? ActiveDropPattern(pointerShiftDown, pointerCtrlDown, pointerAltDown) : DropPattern.One;
    var singleDropGroup = (!isPreview && isSingle && single?.GroupId is Guid singleGroupId)
        ? currentPlot.DropGroups.FirstOrDefault(g => g.Id == singleGroupId)
        : null;
    var groupMembers = selectedDropGroup is null ? new List<Shape>() : GroupShapesOrdered(selectedDropGroup.Id);
    var groupCols = selectedDropGroup is null ? 0 : Math.Max(1, (int)Math.Ceiling(groupMembers.Count / (double)Math.Max(1, selectedDropGroup.Rows)));
    var groupCenterSpacingX = selectedDropGroup?.CenterSpacingXFt ?? 0;
    var groupCenterSpacingY = selectedDropGroup?.CenterSpacingYFt ?? 0;
    var groupGapX = (selectedDropGroup is null || groupMembers.Count == 0) ? 0 : groupCenterSpacingX - groupMembers[0].W;
    var groupGapY = (selectedDropGroup is null || groupMembers.Count == 0) ? 0 : groupCenterSpacingY - groupMembers[0].H;
    var groupLength = selectedDropGroup is null
        ? 0
        : selectedDropGroup.Pattern == DropPattern.Line
            ? Math.Max(0, (groupMembers.Count - 1) * groupCenterSpacingX)
            : Math.Max(0, (groupCols - 1) * groupCenterSpacingX);

    <div class="floating-panel info-panel @(positioned ? "" : "default-info-pos")"
         @ref="infoPanelRef"
         style="@(positioned ? $"left:{library.Ui.InfoPanelX!.Value}px;top:{library.Ui.InfoPanelY!.Value}px;" : "")"
         @onpointermove="OnPanelDragMove"
         @onpointerup="OnPanelDragEnd"
         @onpointercancel="OnPanelDragEnd">
        <div class="panel-header"
             @onpointerdown="StartInfoPanelDrag">
            <span class="panel-title">
                @if (isPreview)
                {
                    <span>Preview · @PanelTitleFor(single!)</span>
                }
                else if (isSingle)
                {
                    @PanelTitleFor(single!)
                }
                else
                {
                    <span>Selection · @selShapes.Count items</span>
                }
            </span>
            <span class="drag-grip" aria-hidden="true">⠿</span>
        </div>
        <div class="panel-body">
            @if (isSingle)
            {
                var info = ShapeInfoLines(single!);
                @foreach (var line in info)
                {
                    <div class="small">@((MarkupString)line)</div>
                }

                @if (!isPreview && drafting is not null && drafting.Kind == ShapeKind.Ruler && single!.Id == drafting.Id)
                {
                    <div class="x-small text-muted mt-1">Click to finish · Ctrl+click to add a vertex</div>
                }

                @if (isPreview && previewDropPattern != DropPattern.One)
                {
                    <div class="small"><span class="text-muted">Drop pattern:</span> <strong>@previewDropPattern</strong></div>
                    <div class="small"><span class="text-muted">Orientation:</span> <strong>@F(stampOrientation)°</strong></div>
                    <div class="small"><span class="text-muted">Item rotation:</span> <strong>@F(stampRotation)°</strong></div>
                    <div class="x-small text-muted">Wheel controls: Shift/Ctrl rotate items, Alt rotates line/array orientation.</div>
                }
            }
            else
            {
                <div class="small text-muted mb-1">Selected items:</div>
                <ul class="selection-list small">
                    @foreach (var grp in selShapes
                                          .GroupBy(s => (Kind: TakeoffKind(s), Name: TakeoffName(s)))
                                          .OrderBy(g => g.Key.Kind, StringComparer.Ordinal)
                                          .ThenBy(g => g.Key.Name, StringComparer.Ordinal))
                    {
                        <li class="selection-item-row">
                            <span class="selection-item-text">
                                <span class="text-muted">@grp.Key.Kind:</span>
                                <strong>@grp.Key.Name</strong>
                                @if (grp.Count() > 1)
                                {
                                    <span class="text-muted">× @grp.Count()</span>
                                }
                            </span>
                            <button class="selection-remove-btn"
                                    title="Remove these items from selection"
                                    @onclick='() => RemoveSelectionGroup(grp.Key.Kind, grp.Key.Name)'>×</button>
                        </li>
                    }
                </ul>

                var rotationValues = selShapes.Select(s => Math.Round(s.Rotation, 3)).Distinct().ToList();
                <div class="small mt-1"><span class="text-muted">Rotation:</span> <strong>@(rotationValues.Count == 1 ? $"{F(rotationValues[0])}°" : "(mixed)")</strong></div>
            }

            @if (!isPreview && selectedDropGroup is null && singleDropGroup is not null)
            {
                <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => SelectDropGroupFromPanel(singleDropGroup.Id)">Select drop group</button>
            }

            @if (!isPreview && selectedDropGroup is not null)
            {
                <hr class="my-2" />
                <div class="fw-bold small mb-1">Drop group layout</div>
                <div class="group-edit-grid">
                    <label>Pattern</label>
                    <div><strong>@selectedDropGroup.Pattern</strong> · @groupMembers.Count items</div>

                    <label>Orientation</label>
                    <div><strong>@F(selectedDropGroup.Rotation)°</strong></div>

                    <label>Length (ft)</label>
                    <input type="number" min="0" max="500" step="0.1" value="@F(groupLength)" @onchange="OnGroupLengthChanged" />

                    <label>Center X (ft)</label>
                    <input type="number" min="0.1" max="200" step="0.1" value="@F(groupCenterSpacingX)" @onchange="(e) => OnGroupCenterSpacingChanged(e, true)" />

                    <label>Gap X (ft)</label>
                    <input type="number" min="-200" max="200" step="0.1" value="@F(groupGapX)" @onchange="(e) => OnGroupBoundingSpacingChanged(e, true)" />

                    @if (selectedDropGroup.Pattern == DropPattern.Array)
                    {
                        <label>Rows</label>
                        <input type="number" min="1" max="@Math.Max(1, groupMembers.Count)" step="1" value="@selectedDropGroup.Rows" @onchange="OnGroupRowsChanged" />

                        <label>Center Y (ft)</label>
                        <input type="number" min="0.1" max="200" step="0.1" value="@F(groupCenterSpacingY)" @onchange="(e) => OnGroupCenterSpacingChanged(e, false)" />

                        <label>Gap Y (ft)</label>
                        <input type="number" min="-200" max="200" step="0.1" value="@F(groupGapY)" @onchange="(e) => OnGroupBoundingSpacingChanged(e, false)" />

                        <label>Stagger</label>
                        <label class="small"><input type="checkbox" checked="@selectedDropGroup.StaggerHalf" @onchange="OnGroupStaggerChanged" /> 1/2 row offset</label>
                    }
                </div>
            }

            @if (!isPreview && (customizable.Count > 0 || fontCustomizable.Count > 0))
            {
                <hr class="my-2" />
                <div class="fw-bold small mb-1">Appearance</div>
                @if (customizable.Count > 0)
                {
                    <div class="color-row">
                        <label class="small">Line</label>
                        <input type="color" value="@strokeValue" @onchange="OnStrokeChanged"
                               class="@(strokeMixed ? "mixed" : "")" title="@(strokeMixed ? "Mixed values — pick to unify" : strokeValue)" />
                        @if (strokeMixed) { <span class="x-small text-muted">(mixed)</span> }
                    </div>
                    <div class="color-row">
                        <label class="small">Fill</label>
                        <input type="color" value="@fillValue" @onchange="OnFillChanged"
                               class="@(fillMixed ? "mixed" : "")" title="@(fillMixed ? "Mixed values — pick to unify" : fillValue)" />
                        @if (fillMixed) { <span class="x-small text-muted">(mixed)</span> }
                    </div>
                    <div class="color-row">
                        <label class="small">Opacity</label>
                        <input type="range" min="0" max="1" step="0.05" value="@F(opValue)" @oninput="OnFillOpacityChanged"
                               class="@(opMixed ? "mixed" : "")" />
                        <span class="x-small text-muted">@(opMixed ? "(mixed)" : $"{opValue * 100:0}%")</span>
                    </div>
                }
                @if (fontCustomizable.Count > 0)
                {
                    <div class="color-row">
                        <label class="small">Font</label>
                        <input type="range" min="0.5" max="3" step="0.05" value="@F(fontValue)" @oninput="OnFontScaleChanged"
                               class="@(fontMixed ? "mixed" : "")" />
                        <span class="x-small text-muted">@(fontMixed ? "(mixed)" : $"{fontValue * 100:0}%")</span>
                    </div>
                }
                @if (customizable.Count > 0)
                {
                    <button class="btn btn-sm btn-link p-0 small me-2" @onclick="ResetSelectedColors">Reset colors</button>
                }
                @if (fontCustomizable.Count > 0)
                {
                    <button class="btn btn-sm btn-link p-0 small" @onclick="ResetSelectedFont">Reset font</button>
                }
            }
            else if (!isPreview && selShapes.Count > 0)
            {
                <hr class="my-2" />
                <div class="x-small text-muted">
                    Color customization is not available for trees, bushes, or plants.
                </div>
            }

            @if (isSingle && (single!.Kind == ShapeKind.Tree || single.Kind == ShapeKind.Bush))
            {
                <hr class="my-2" />
                @if (wikiLoading)
                {
                    <div class="x-small text-muted">Loading Wikipedia summary…</div>
                }
                else if (wikiSummary is not null)
                {
                    <div class="wiki-block">
                        @if (!string.IsNullOrEmpty(wikiSummary.ThumbnailUrl))
                        {
                            <img class="wiki-thumb" src="@wikiSummary.ThumbnailUrl" alt="@wikiSummary.Title" />
                        }
                        <div class="fw-bold small">@wikiSummary.Title</div>
                        <div class="x-small wiki-extract">@wikiSummary.Extract</div>
                        <a class="x-small" href="@wikiSummary.PageUrl" target="_blank" rel="noopener">
                            Read more on Wikipedia →
                        </a>
                    </div>
                }
                else
                {
                    var topic = WikipediaTopic(single.Label ?? "");
                    var searchUrl = $"https://en.wikipedia.org/w/index.php?search={System.Net.WebUtility.UrlEncode(topic)}";
                    <div class="x-small text-muted">No Wikipedia summary found.</div>
                    <a class="x-small" href="@searchUrl" target="_blank" rel="noopener">Search Wikipedia →</a>
                }
            }

            @if (isSingle && ResolveCustomTileInfoItem(single!, isPreview) is { } customInfo)
            {
                <hr class="my-2" />
                @if (!string.IsNullOrWhiteSpace(customInfo.TilePreviewImageFileName))
                {
                    <img class="wiki-thumb" src="@TileImageUrl(customInfo.TilePreviewImageFileName!)" alt="@customInfo.Code" />
                }

                @if (customTileCitationLoading)
                {
                    <div class="x-small text-muted">Loading citation details…</div>
                }
                else if (customTileCitation is not null)
                {
                    <div class="wiki-block">
                        @if (!string.IsNullOrEmpty(customTileCitation.ImageUrl))
                        {
                            <img class="wiki-thumb" src="@customTileCitation.ImageUrl" alt="@customTileCitation.Title" />
                        }
                        <div class="fw-bold small">@customTileCitation.Title</div>
                        @if (!string.IsNullOrWhiteSpace(customTileCitation.Extract))
                        {
                            <div class="x-small wiki-extract">@customTileCitation.Extract</div>
                        }
                        <a class="x-small" href="@customTileCitation.PageUrl" target="_blank" rel="noopener">Open source page →</a>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(customInfo.CitationUrl))
                {
                    <a class="x-small" href="@customInfo.CitationUrl" target="_blank" rel="noopener">Open source page →</a>
                }
            }

            @if (isSingle && single!.Kind == ShapeKind.Plant)
            {
                var rules = CompanionRules.ForCode(single.Label ?? "");
                var nearby = isPreview ? new List<(Shape other, double distFt)>() : NearbyPlants(single, currentPlot.Shapes);
                <hr class="my-2" />
                @if (!isPreview)
                {
                    <div class="fw-bold small mb-1">Companions nearby</div>
                    @if (nearby.Count == 0)
                    {
                        <div class="x-small text-muted">No other plants within 2× spacing.</div>
                    }
                    else
                    {
                        <ul class="companion-list small">
                            @foreach (var (other, distFt) in nearby)
                            {
                                var otherName = other.Label ?? "";
                                var verdict = rules.good.Any(g => string.Equals(g, otherName, StringComparison.OrdinalIgnoreCase)) ? "good"
                                            : rules.bad.Any(b => string.Equals(b, otherName, StringComparison.OrdinalIgnoreCase))  ? "bad"
                                            : "neutral";
                                <li class="comp-@verdict">
                                    <span class="comp-marker"></span>
                                    <strong>@otherName</strong>
                                    <span class="text-muted">— @F(distFt) ft</span>
                                </li>
                            }
                        </ul>
                    }
                }
                @if (rules.good.Count > 0 || rules.bad.Count > 0)
                {
                    <div class="x-small text-muted mt-2">
                        @if (rules.good.Count > 0)
                        {
                            <div><strong>Plant near:</strong> @string.Join(", ", rules.good)</div>
                        }
                        @if (rules.bad.Count > 0)
                        {
                            <div><strong>Avoid:</strong> @string.Join(", ", rules.bad)</div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@if (showNewPlotDialog)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog @(string.IsNullOrWhiteSpace(newPlotBackgroundImageFileName) ? string.Empty : "modal-xl")" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditingPlotSettings ? "Edit Garden Plot" : "New Garden Plot")</h5>
                    <button type="button" class="btn-close" @onclick="CancelNewPlot"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Name</label>
                        <input class="form-control form-control-sm" @bind="newPlotName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Shape</label>
                        <select class="form-select form-select-sm" @bind="newPlotShape">
                            <option value="Rectangle">Rectangle (flat)</option>
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col">
                            <label class="form-label small">Width (ft)</label>
                            <input type="number" min="1" max="500" step="0.5" class="form-control form-control-sm"
                                   @bind="newPlotWidth" />
                        </div>
                        <div class="col">
                            <label class="form-label small">Height (ft)</label>
                            <input type="number" min="1" max="500" step="0.5" class="form-control form-control-sm"
                                   @bind="newPlotHeight" />
                        </div>
                    </div>

                    <div class="mb-2 mt-2">
                        <label class="form-label small">Background image</label>
                        <InputFile OnChange="OnPlotBackgroundImageSelected" accept="image/*" class="form-control form-control-sm" />
                        @if (!string.IsNullOrWhiteSpace(newPlotBackgroundImageWarning))
                        {
                            <div class="x-small text-warning mt-1">@newPlotBackgroundImageWarning</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(newPlotBackgroundImageFileName))
                        {
                            <div class="row g-2 mt-2">
                                <div class="col">
                                    <label class="form-label x-small">Background opacity</label>
                                    <input type="range" min="0" max="1" step="0.05" class="form-range"
                                           @bind="newPlotBackgroundOpacity" />
                                    <div class="x-small text-muted">@F(newPlotBackgroundOpacity * 100)%</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearPlotBackgroundImage">Remove image</button>
                                <span class="x-small text-muted">Use the Scale button to calibrate directly on the main canvas.</span>
                            </div>
                            <img class="plot-calibration-image mt-2"
                                 src="@PlotImageUrl(newPlotBackgroundImageFileName!)"
                                 alt="Plot background calibration preview" />
                        }
                    </div>

                    <div class="mb-2">
                        <label class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" @bind="newPlotShowGrid" />
                            <span class="form-check-label small">Show grid</span>
                        </label>

                        @if (newPlotShowGrid)
                        {
                            <div class="row g-2">
                                <div class="col-4">
                                    <label class="form-label x-small">Line color</label>
                                    <input type="color" class="form-control form-control-sm form-control-color custom-color" @bind="newPlotGridColor" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label x-small">Line width</label>
                                    <input type="number" min="0.001" max="0.2" step="0.001" class="form-control form-control-sm" @bind="newPlotGridLineWidth" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label x-small">Opacity</label>
                                    <input type="number" min="0" max="1" step="0.05" class="form-control form-control-sm" @bind="newPlotGridOpacity" />
                                </div>
                            </div>
                        }

                    </div>

                    <div class="mb-2">
                        <label class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" @bind="newPlotShowScaleDisplay" />
                            <span class="form-check-label small">Show scale display on canvas</span>
                        </label>
                        <button class="btn btn-sm btn-outline-primary" @onclick="BeginScaleCalibrationFromDialog">Scale</button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(newPlotError))
                    {
                        <div class="small text-danger mt-2">@newPlotError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CancelNewPlot">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="SavePlotSettingsAsync">@(isEditingPlotSettings ? "Save" : "Create")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showAddCustomTileDialog)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(IsEditingCustomTile ? "Edit Custom Tile" : "Add Custom Tile")</h5>
                    <button type="button" class="btn-close" @onclick="CancelAddCustomTile"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Name</label>
                        <input class="form-control form-control-sm" @bind="newCustomTileName" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label class="form-label small">Shape</label>
                            <select class="form-select form-select-sm" @bind="newCustomTileShape">
                                <option value="Rectangle">Rectangle</option>
                                <option value="Oval">Oval</option>
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label small">Line color</label>
                            <input type="color" class="form-control form-control-sm form-control-color custom-color" @bind="newCustomTileStrokeColor" />
                        </div>
                        <div class="col">
                            <label class="form-label small">Fill color</label>
                            <input type="color" class="form-control form-control-sm form-control-color custom-color" @bind="newCustomTileFillColor" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label class="form-label small">Width (ft)</label>
                            <input type="number" min="0.1" max="200" step="0.1" class="form-control form-control-sm" @bind="newCustomTileWidthFt" />
                        </div>
                        <div class="col">
                            <label class="form-label small">Height (ft)</label>
                            <input type="number" min="0.1" max="200" step="0.1" class="form-control form-control-sm" @bind="newCustomTileHeightFt" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small">Palette tile image (for button)</label>
                        <InputFile OnChange="OnCustomTilePreviewImageSelected" accept="image/*" class="form-control form-control-sm" />
                        @if (!string.IsNullOrWhiteSpace(newCustomTilePreviewImageWarning))
                        {
                            <div class="x-small text-warning mt-1">@newCustomTilePreviewImageWarning</div>
                        }
                    </div>
                    <label class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" @bind="newCustomTileUseButtonImageForBackground" />
                        <span class="form-check-label small">Use button image for tile background</span>
                    </label>
                    <div class="mb-2">
                        <label class="form-label small">Tile background image (for drawn shape)</label>
                        <InputFile OnChange="OnCustomTileBackgroundImageSelected" accept="image/*" class="form-control form-control-sm" disabled="@newCustomTileUseButtonImageForBackground" />
                        @if (newCustomTileUseButtonImageForBackground)
                        {
                            <div class="x-small text-muted mt-1">The drawn tile will reuse the button image.</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(newCustomTileBackgroundImageWarning))
                        {
                            <div class="x-small text-warning mt-1">@newCustomTileBackgroundImageWarning</div>
