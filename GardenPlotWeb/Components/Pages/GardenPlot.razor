            ShapeKind.Oval => $"{s.W:0.##}'×{s.H:0.##}'",
            ShapeKind.FreeDraw => "(unnamed)",
            ShapeKind.Ruler => "(measurement)",
            ShapeKind.CircleRuler => $"r={Math.Abs(s.W / 2):0.##}'",
            ShapeKind.RectRuler => $"{Math.Abs(s.W):0.##}'×{Math.Abs(s.H):0.##}'",
