        </button>
        <button class="dropdown-item" type="button" @onclick="ShowMaterialPickerForTakeoffSelection" disabled="@(!CanChangeSelectedTakeoffMaterials())">
            <span class="me-2">⇄</span> Change material
        </button>
        <div class="dropdown-divider"></div>
