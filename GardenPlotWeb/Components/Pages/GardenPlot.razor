                                           @onchange="OnCustomerCutDateChanged" />
                                </div>
                            </div>
                            <div class="takeoff-cover-preview mt-2">
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(library.Ui.FirmName) ? "Your firm" : library.Ui.FirmName)</div>
                                <div>@currentPlot.Name</div>
                                <div>@FormatCustomerCutDate(library.Ui)</div>
                            </div>
                        </div>
                    }

                    @if (viewMode == TakeoffViewMode.Item)
                    {
                        <table class="table table-sm takeoff-table mb-0">
                            <thead>
                                @if (isInternalView)
                                {
                                    <tr>
                                        <th class="text-end">#</th>
                                        <th>Kind</th>
                                        <th>Name</th>
                                        <th class="text-end">Qty</th>
                                        <th>Unit</th>
                                        <th class="text-end">Waste %</th>
                                        <th>Labor</th>
                                        <th class="text-end">Hours</th>
                                        <th class="text-end">Actual hrs</th>
                                        @if (showMaterialCost)
                                        {
                                            <th class="text-end">Material $</th>
                                        }
                                        @if (showLaborCost)
                                        {
                                            <th class="text-end">Labor $</th>
                                        }
                                        @if (showMarkupPercent)
                                        {
                                            <th class="text-end">Markup %</th>
                                        }
                                        @if (showLineTotal)
                                        {
                                            <th class="text-end">Line $</th>
                                        }
                                        <th title="Bound to a canvas shape?">Bound</th>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <th>Kind</th>
                                        <th>Name</th>
                                        <th class="text-end">Line $</th>
                                    </tr>
                                }
                            </thead>
                            <tbody>
                                @if (isInternalView)
                                {
                                    @foreach (var row in itemRows)
                                    {
                                        var sourceItem = currentPlot.Takeoff.First(t => t.Id == row.Id);
                                        var rowSelected = IsTakeoffRowSelected(sourceItem);
                                        var rowPulse = sourceItem.ShapeId is Guid pulseShapeId && recentMaterialChangeShapeIds.Contains(pulseShapeId);
                                        <tr class="@(row.Unbound ? "table-warning" : "") @(rowSelected ? "takeoff-row-selected" : "") @(rowPulse ? "takeoff-row-pulse" : "")"
                                            @onclick="(e) => OnTakeoffRowClick(sourceItem, e)"
                                            @oncontextmenu="(e) => OnTakeoffRowContextMenu(sourceItem, e)"
                                            @oncontextmenu:preventDefault="true"
                                            style="cursor: pointer;">
                                            <td class="text-end text-muted">@row.Id</td>
                                            <td>@row.Kind</td>
                                            <td>
                                                @row.Name
                                                @if (row.Unbound)
                                                {
                                                    <span class="text-warning-emphasis small ms-1" title="Catalog item not found">(Unbound)</span>
                                                }
                                            </td>
                                            <td class="text-end">@FormatTakeoffNumber(row.Quantity)</td>
                                            <td>@row.Unit</td>
                                            <td class="text-end">
                                                @FormatTakeoffPercent(row.WastePercent)
                                                @if (row.HasWasteOverride)
                                                {
                                                    <span class="text-primary" title="Override">*</span>
                                                }
                                            </td>
                                            <td>
                                                @row.LaborType
                                                @if (row.HasLaborTypeOverride)
                                                {
                                                    <span class="text-primary" title="Override">*</span>
                                                }
                                            </td>
                                            <td class="text-end">@FormatTakeoffNumber(row.LaborHours)</td>
                                            <td class="text-end" style="min-width:6.5rem;" @onclick:stopPropagation="true">
                                                <input type="number"
                                                       min="0"
                                                       step="0.25"
                                                       class="form-control form-control-sm text-end"
                                                       value="@(sourceItem.ActualLaborHours?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty)"
                                                       @onchange="@(async e => await OnActualLaborHoursChangedAsync(sourceItem, e))" />
                                            </td>
                                            @if (showMaterialCost)
                                            {
                                                <td class="text-end">@TakeoffMath.FormatCurrency(row.MaterialCost)</td>
                                            }
                                            @if (showLaborCost)
                                            {
                                                <td class="text-end">@TakeoffMath.FormatCurrency(row.LaborCost)</td>
                                            }
                                            @if (showMarkupPercent)
                                            {
                                                <td class="text-end">
                                                    @FormatTakeoffPercent(row.MarkupPercent)
                                                    @if (row.HasMarkupOverride)
                                                    {
                                                        <span class="text-primary" title="Override">*</span>
                                                    }
                                                </td>
                                            }
                                            @if (showLineTotal)
                                            {
                                                <td class="text-end">@TakeoffMath.FormatCurrency(row.LineTotal)</td>
                                            }
                                            <td class="text-center" title="@(row.Bound ? "Bound to canvas shape" : "Virtual item (not on canvas)")">
                                                @(row.Bound ? "✓" : "—")
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    @foreach (var kindGroup in itemRows.GroupBy(row => row.Kind).OrderBy(group => group.Key, StringComparer.Ordinal))
                                    {
                                        @foreach (var row in kindGroup)
                                        {
                                            <tr>
                                                <td>@row.Kind</td>
                                                <td>@row.Name</td>
                                                <td class="text-end">@TakeoffMath.FormatCurrency(row.LineTotal)</td>
                                            </tr>
                                        }
                                        <tr class="table-secondary takeoff-subtotal-row">
                                            <td colspan="2">@kindGroup.Key subtotal</td>
                                            <td class="text-end">@TakeoffMath.FormatCurrency(TakeoffMath.SumCurrency(kindGroup.Select(row => row.LineTotal)))</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            @if (isInternalView && labor.Count > 0)
                            {
                                <tfoot>
                                    <tr>
                                        <td colspan="@(itemInternalColumnCount - 1)" class="text-end text-muted small">Total labor hours</td>
                                        <td>
                                            @foreach (var (Type, Hours) in labor)
                                            {
                                                <span class="badge text-bg-light text-dark me-1">@Type: @Hours.ToString("0.##", CultureInfo.InvariantCulture) h</span>
                                            }
                                        </td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    }
                    else
                    {
                        <table class="table table-sm takeoff-table mb-0">
                            <thead>
                                <tr>
                                    <th>Kind</th>
                                    <th>Name</th>
                                    <th class="text-end">Count</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Unit</th>
                                    @if (isInternalView && showMaterialCost)
                                    {
                                        <th class="text-end">Material $</th>
                                    }
                                    @if (isInternalView && showLaborCost)
                                    {
                                        <th class="text-end">Labor $</th>
                                    }
                                    @if (isInternalView && showMarkupPercent)
                                    {
                                        <th class="text-end">Markup %</th>
                                    }
                                    @if (showLineTotal)
                                    {
                                        <th class="text-end">Line $</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (isInternalView)
                                {
                                    @foreach (var row in summaryRows)
                                    {
                                        <tr class="@(IsTakeoffSummaryRowSelected(row) ? "table-active" : string.Empty)"
                                            @onclick="() => SelectTakeoffSummaryRow(row)"
                                            style="cursor:@(row.ShapeId.HasValue || row.ParentShapeId.HasValue ? "pointer" : "default");">
                                            <td>@row.Kind</td>
                                            <td>@row.Name</td>
                                            <td class="text-end">@row.Count</td>
                                            <td class="text-end">@FormatTakeoffNumber(row.Quantity)</td>
                                            <td>@row.Unit</td>
                                            @if (showMaterialCost)
                                            {
                                                <td class="text-end">@TakeoffMath.FormatCurrency(row.MaterialCost)</td>
                                            }
                                            @if (showLaborCost)
                                            {
                                                <td class="text-end">@TakeoffMath.FormatCurrency(row.LaborCost)</td>
                                            }
                                            @if (showMarkupPercent)
                                            {
                                                <td class="text-end">@FormatTakeoffPercent(row.MarkupPercent)</td>
                                            }
                                            @if (showLineTotal)
                                            {
                                                <td class="text-end">@TakeoffMath.FormatCurrency(row.LineTotal)</td>
                                            }
                                        </tr>
                                    }
                                }
                                else
                                {
                                    @foreach (var kindGroup in summaryRows.GroupBy(row => row.Kind).OrderBy(group => group.Key, StringComparer.Ordinal))
                                    {
                                        @foreach (var row in kindGroup)
                                        {
                                            <tr class="@(IsTakeoffSummaryRowSelected(row) ? "table-active" : string.Empty)"
                                                @onclick="() => SelectTakeoffSummaryRow(row)"
                                                style="cursor:@(row.ShapeId.HasValue || row.ParentShapeId.HasValue ? "pointer" : "default");">
                                                <td>@row.Kind</td>
                                                <td>@row.Name</td>
                                                <td class="text-end">@row.Count</td>
                                                <td class="text-end">@FormatTakeoffNumber(row.Quantity)</td>
                                                <td>@row.Unit</td>
                                                <td class="text-end">@TakeoffMath.FormatCurrency(row.LineTotal)</td>
                                            </tr>
                                        }
                                        <tr class="table-secondary takeoff-subtotal-row">
                                            <td colspan="5">@kindGroup.Key subtotal</td>
                                            <td class="text-end">@TakeoffMath.FormatCurrency(TakeoffMath.SumCurrency(kindGroup.Select(row => row.LineTotal)))</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            @if (isInternalView && labor.Count > 0)
                            {
                                <tfoot>
                                    <tr>
                                        <td colspan="@(summaryInternalColumnCount - 1)" class="text-end text-muted small">Total labor hours</td>
                                        <td>
                                            @foreach (var (Type, Hours) in labor)
                                            {
                                                <span class="badge text-bg-light text-dark me-1">@Type: @Hours.ToString("0.##", CultureInfo.InvariantCulture) h</span>
                                            }
                                        </td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    }
                }
            </div>
        </div>
    }
}

@if (showTakeoffContextMenu && takeoffContextMenuItemId is int ctxId && currentPlot is not null)
{
    <div class="takeoff-ctx-backdrop" @onclick="CloseTakeoffContextMenu"
         @oncontextmenu="CloseTakeoffContextMenu" @oncontextmenu:preventDefault="true"></div>
    <div class="dropdown-menu show takeoff-ctx-menu"
         style="@($"left:{takeoffContextMenuX}px;top:{takeoffContextMenuY}px;")"
         @onclick:stopPropagation="true">
        <button class="dropdown-item" type="button" @onclick="() => BeginEditTakeoffItem(ctxId)">
            <span class="me-2">✎</span> Edit
        </button>
        <button class="dropdown-item" type="button" @onclick="() => DuplicateTakeoffItem(ctxId)">
