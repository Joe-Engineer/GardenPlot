@if (EditingTakeoff is { } editing && currentPlot is not null)
{
    var editCatalog = CatalogFor(editing);
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">Edit takeoff item #@editing.Id</h6>
                    <button type="button" class="btn-close" @onclick="CloseEditTakeoffItem"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small mb-0">Name</label>
                        <input class="form-control form-control-sm"
                               value="@(editing.NameOverride ?? TakeoffMath.DisplayName(editing, editCatalog))"
                               @oninput="(e) => editing.NameOverride = (string?)e.Value" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label class="form-label small mb-0">Quantity</label>
                            <input type="number" step="0.01" class="form-control form-control-sm"
                                   @bind="editing.Quantity" />
                        </div>
                        <div class="col">
                            <label class="form-label small mb-0">Unit</label>
                            <input class="form-control form-control-sm"
                                   value="@TakeoffMath.EffectiveUnit(editing, editCatalog)"
                                   @oninput="(e) => editing.UnitOverride = string.IsNullOrWhiteSpace((string?)e.Value) ? null : (string?)e.Value" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label class="form-label small mb-0">Waste %</label>
                            <input type="number" step="0.5" class="form-control form-control-sm"
                                   value="@TakeoffMath.EffectiveWastePercent(editing, editCatalog)"
                                   @oninput="(e) => editing.WastePercentOverride = double.TryParse((string?)e.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : null" />
                        </div>
                        <div class="col">
                            <label class="form-label small mb-0">Hours / unit</label>
                            <input type="number" step="0.05" class="form-control form-control-sm"
                                   value="@TakeoffMath.EffectiveLaborHoursPerUnit(editing, editCatalog)"
                                   @oninput="(e) => editing.LaborHoursPerUnitOverride = double.TryParse((string?)e.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : null" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label class="form-label small mb-0">Labor type</label>
                            <select class="form-select form-select-sm"
                                    value="@TakeoffMath.EffectiveLaborType(editing, editCatalog)"
                                    @onchange="(e) => editing.LaborTypeOverride = Enum.TryParse<LaborType>((string?)e.Value, out var lt) ? lt : null">
                                @foreach (var lt in Enum.GetValues<LaborType>())
                                {
                                    <option value="@lt">@lt</option>
                                }
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label small mb-0">Markup %</label>
                            <input type="number" step="0.1" class="form-control form-control-sm"
                                   value="@TakeoffMath.EffectiveMarkupPercent(editing, currentPlot)"
                                   @oninput="(e) => editing.MarkupPercentOverride = double.TryParse((string?)e.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : null" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Notes</label>
                        <textarea class="form-control form-control-sm" rows="2"
                                  value="@(editing.Notes ?? "")"
                                  @oninput="(e) => editing.Notes = (string?)e.Value"></textarea>
                    </div>
                    <div class="takeoff-cost-preview small text-muted mb-1">
                        <div>Material: <strong>@TakeoffMath.FormatCurrency(TakeoffMath.EffectiveMaterialCost(editing, editCatalog))</strong></div>
                        <div>Labor: <strong>@TakeoffMath.FormatCurrency(TakeoffMath.EffectiveLaborCost(editing, editCatalog, library.Ui))</strong></div>
                        <div>Line: <strong>@TakeoffMath.FormatCurrency(TakeoffMath.LineTotal(editing, editCatalog, library.Ui, currentPlot))</strong></div>
                    </div>
                    <div class="form-text x-small">Bound: @(editing.ShapeId.HasValue ? "shape on canvas" : "virtual (no shape)")</div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-sm btn-primary" @onclick="CloseEditTakeoffItem">Done</button>
                </div>
            </div>
        </div>
    </div>
}

@{
    var infoRuler = drafting is not null && IsRulerShape(drafting)
        ? drafting
        : (currentPlot is not null && PrimarySelectedId is { } sid
            ? currentPlot.Shapes.FirstOrDefault(z => z.Id == sid && IsRulerShape(z))
            : null);
    var primaryShape = currentPlot is not null && PrimarySelectedId is { } pid
        ? currentPlot.Shapes.FirstOrDefault(z => z.Id == pid)
        : null;
}

@if (!IsConceptMode && (selectedIds.Count > 0 || (currentTool == Tool.Stamp && selectedItem is not null) || infoRuler is not null) && currentPlot is not null)
{
    var forceRulerMode = infoRuler is not null && (drafting is not null || selectedIds.Count <= 1);
    var stampPreview = (!forceRulerMode && selectedIds.Count == 0 && currentTool == Tool.Stamp && selectedItem is not null)
        ? PreviewShapeFromItem(selectedItem)
        : null;
    var isPreview = stampPreview is not null;
    var selShapes = forceRulerMode
        ? new List<Shape> { infoRuler! }
        : stampPreview is not null
        ? new List<Shape> { stampPreview }
        : SelectedShapes().ToList();
    var positioned = library.Ui.InfoPanelX is double && library.Ui.InfoPanelY is double;
    var isSingle = selShapes.Count == 1;
    var single = isSingle ? selShapes[0] : null;
    var customizable = isPreview ? new List<Shape>() : selShapes.Where(IsColorCustomizable).ToList();
    var fontCustomizable = isPreview ? new List<Shape>() : selShapes.Where(IsFontCustomizable).ToList();
    var strokeSet = customizable.Select(EffectiveStroke).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    var fillSet   = customizable.Select(EffectiveFill).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    var opSet     = customizable.Select(EffectiveFillOpacity).Distinct().ToList();
    var fontSet   = fontCustomizable.Select(EffectiveFontScale).Distinct().ToList();
    var strokeMixed = strokeSet.Count > 1;
    var fillMixed   = fillSet.Count > 1;
    var opMixed     = opSet.Count > 1;
    var fontMixed   = fontSet.Count > 1;
    var strokeValue = strokeMixed ? "#808080" : (strokeSet.Count == 1 ? strokeSet[0] : "#000000");
    var fillValue   = fillMixed   ? "#808080" : (fillSet.Count == 1   ? fillSet[0]   : "#000000");
    var opValue     = opMixed     ? 0.5       : (opSet.Count == 1     ? opSet[0]     : 1.0);
    var fontValue   = fontMixed   ? 1.0       : (fontSet.Count == 1   ? fontSet[0]   : 1.0);
    var selectedDropGroup = isPreview ? null : GetCurrentSelectedDropGroup();
    var previewDropPattern = isPreview ? ActiveDropPattern(pointerShiftDown, pointerCtrlDown, pointerAltDown) : DropPattern.One;
    var singleDropGroup = (!isPreview && isSingle && single?.GroupId is Guid singleGroupId)
        ? currentPlot.DropGroups.FirstOrDefault(g => g.Id == singleGroupId)
        : null;
    IReadOnlyList<GardenTask> singleShapeTasks = !isPreview && isSingle && single is not null && CanBindTasks(single)
        ? TasksForShape(single.Id)
        : [];
    IReadOnlyList<GardenTaskTemplate> singleTaskTemplates = !isPreview && isSingle && single is not null && CanBindTasks(single)
        ? GardenTaskTemplates.GetTemplatesForShape(single)
        : [];
    var groupMembers = selectedDropGroup is null ? new List<Shape>() : GroupShapesOrdered(selectedDropGroup.Id);
    var groupCols = selectedDropGroup is null ? 0 : Math.Max(1, (int)Math.Ceiling(groupMembers.Count / (double)Math.Max(1, selectedDropGroup.Rows)));
    var groupCenterSpacingX = selectedDropGroup?.CenterSpacingXFt ?? 0;
    var groupCenterSpacingY = (selectedDropGroup is null || groupMembers.Count == 0)
        ? 0
        : selectedDropGroup.Pattern == DropPattern.Array
            ? ResolveArrayRowSpacing(groupCenterSpacingX, selectedDropGroup.CenterSpacingYFt, selectedDropGroup.Triangulated, groupMembers[0].H)
            : selectedDropGroup.CenterSpacingYFt;
    var groupGapX = (selectedDropGroup is null || groupMembers.Count == 0) ? 0 : groupCenterSpacingX - groupMembers[0].W;
    var groupGapY = (selectedDropGroup is null || groupMembers.Count == 0) ? 0 : groupCenterSpacingY - groupMembers[0].H;
    var groupLength = selectedDropGroup is null
        ? 0
        : selectedDropGroup.Pattern == DropPattern.AlongPath
            ? GetAlongPathSourceLengthFt(selectedDropGroup)
            : selectedDropGroup.Pattern == DropPattern.Line
                ? Math.Max(0, (groupMembers.Count - 1) * groupCenterSpacingX)
                : Math.Max(0, (groupCols - 1) * groupCenterSpacingX);
    var groupSpacingOverrideValue = selectedDropGroup?.SpacingFtOverride?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty;
    var groupOffsetValue = selectedDropGroup?.OffsetIn?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty;

    <div class="floating-panel info-panel @(positioned ? "" : "default-info-pos")"
         @ref="infoPanelRef"
         style="@(positioned ? $"left:{library.Ui.InfoPanelX!.Value}px;top:{library.Ui.InfoPanelY!.Value}px;" : "")"
         @onpointermove="OnPanelDragMove"
         @onpointerup="OnPanelDragEnd"
         @onpointercancel="OnPanelDragEnd">
        <div class="panel-header"
             @onpointerdown="StartInfoPanelDrag">
            <span class="panel-title">
                @if (isPreview)
                {
                    <span>Preview · @PanelTitleFor(single!)</span>
                }
                else if (isSingle)
                {
                    @PanelTitleFor(single!)
                }
                else
                {
                    <span>Selection · @selShapes.Count items</span>
                }
            </span>
            <span class="drag-grip" aria-hidden="true">⠿</span>
        </div>
        <div class="panel-body">
            @if (isSingle)
            {
                var info = ShapeInfoLines(single!);
                @foreach (var line in info)
                {
                    <div class="small">@((MarkupString)line)</div>
                }

                @if (!isPreview && drafting is not null && drafting.Kind == ShapeKind.Ruler && single!.Id == drafting.Id)
                {
                    <div class="x-small text-muted mt-1">Click to finish · Ctrl+click to add a vertex</div>
                }

                @if (!isPreview)
                {
                    <div class="rotation-editor mt-2 pt-2 border-top">
                        <div class="small fw-semibold mb-1">Rotation</div>
                        <div class="rotation-editor-row">
                            <input type="number"
                                   min="0"
                                   max="360"
                                   step="1"
                                   class="form-control form-control-sm rotation-input"
                                   value="@GetSelectedRotationInputValue(single!)"
                                   @oninput="OnSelectedRotationInput"
                                   @onchange="OnSelectedRotationChanged"
                                   @onkeydown="OnSelectedRotationKeyDown" />
                            <span class="small text-muted">deg</span>
                        </div>
                        <div class="btn-group btn-group-sm rotation-presets" role="group" aria-label="Set shape rotation">
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => CommitSelectedShapeRotationAsync(0)">0°</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => CommitSelectedShapeRotationAsync(45)">45°</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => CommitSelectedShapeRotationAsync(90)">90°</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => CommitSelectedShapeRotationAsync(180)">180°</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => CommitSelectedShapeRotationAsync(270)">270°</button>
                        </div>
                    </div>
                }

                @if (!isPreview && single!.Kind == ShapeKind.Edge)
                {
                    <div class="ground-cover-info mt-2 pt-2 border-top">
                        <div class="small fw-semibold mb-1">Edge</div>
                        <div class="small mb-1">
                            <strong>@($"{TakeoffMath.EffectiveLengthFt(single!):0.##} lf")</strong>
                            <span class="text-muted"> · segments: @TakeoffMath.EffectiveSegmentCount(single!)</span>
                        </div>
                        <label class="small d-inline-flex align-items-center gap-1 mb-0">
                            <input type="checkbox"
                                   checked="@single!.CloseEdge"
                                   @onchange="@(e => OnEdgeCloseChanged(single!, e))" />
                            <span>Close edge</span>
                        </label>
                    </div>
                }

                @if (!isPreview && IsGroundCoverShape(single!))
                {
                    var materialItem = MaterialItemFor(single!);
                    var materialCode = MaterialCodeFor(single!);
                    var materialSoldBy = MaterialSoldByFor(single!, materialItem);
                    var materialArea = GroundCoverMath.AreaFt2(single!);
                    var materialDepth = GroundCoverMath.ResolveDepthIn(single!, materialItem);
                    var materialWaste = GroundCoverMath.ResolveWastePercent(single!, materialItem);
                    var materialVolume = GroundCoverMath.QuantityWithWaste(GroundCoverMath.VolumeYd3(materialArea, materialDepth), materialWaste);
                    <div class="ground-cover-info mt-2 pt-2 border-top">
                        <div class="small fw-semibold mb-1">Material</div>
                        <div class="small mb-1 d-flex align-items-center gap-2">
                            <span class="text-muted">Selected:</span>
                            <strong>@MaterialDisplayName(single!)</strong>
                            <span class="gc-swatch"
                                  style="@($"background:{single!.Fill ?? "#8a8276"};border-color:{single!.Stroke ?? "#3f3a30"};")"
                                  title="@(string.IsNullOrWhiteSpace(single!.TextureKey) ? "color" : single!.TextureKey)"></span>
                            @if (materialSoldBy == MaterialSoldBy.Area)
                            {
                                <span class="badge text-bg-secondary">surface</span>
                            }
                            <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="ShowMaterialPickerForSelection">Change…</button>
                        </div>
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <label class="small text-muted mb-0">Material:</label>
                            <select class="form-select form-select-sm"
                                    value="@materialCode"
                                    @onchange="@(e => OnMaterialChanged(single!, e.Value?.ToString()))">
                                <option value="">(select material)</option>
                                @foreach (var group in MaterialPickerGroups)
                                {
                                    <optgroup label="@MaterialCategoryLabel(group.Category)">
                                        @foreach (var item in group.Items)
                                        {
                                            <option value="@item.Code">@item.Code</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <div class="small mb-1">
                            <span class="text-muted">Area:</span>
                            <strong>@ClipAreaSummary(single!)</strong>
                            @if (!single!.IsGroundCoverSurface && single!.GroundCoverDepthIn is double d && d > 0)
                            {
                                <span class="text-muted ms-2">Volume:</span>
                                <strong>@($"{GroundCoverMath.VolumeYd3(NetAreaFt2(single!), d):0.##} yd³")</strong>
                            }
                        </div>
                        @if (materialSoldBy == MaterialSoldBy.Volume)
                        {
                            <div class="d-flex align-items-center gap-1 mb-1">
                                <label class="small text-muted mb-0">Depth (in):</label>
                                <input type="number" min="0" step="0.1"
                                       class="form-control form-control-sm gc-depth-input"
                                       value="@NumberValue(single!.DepthIn)"
                                       placeholder="@NumberPlaceholder(materialItem?.DefaultDepthIn ?? 0)"
                                       @oninput="@(e => OnGroundCoverDepthChanged(single!, e.Value?.ToString()))" />
                            </div>
                        }
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <label class="small text-muted mb-0">Waste (%):</label>
                            <input type="number" min="0" step="0.1"
                                   class="form-control form-control-sm gc-depth-input"
                                   value="@NumberValue(single!.WastePercent)"
                                   placeholder="@NumberPlaceholder(materialItem?.DefaultWastePercent ?? 0)"
                                   @oninput="@(e => OnGroundCoverWasteChanged(single!, e.Value?.ToString()))" />
                        </div>
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <label class="small text-muted mb-0">Texture:</label>
                            <select class="form-select form-select-sm"
                                    value="@(single!.TextureKey ?? string.Empty)"
                                    @onchange="@(e => OnGroundCoverTextureChanged(single!, e.Value?.ToString()))">
                                <option value="">(none)</option>
                                @foreach (var k in GroundCoverTextureKeys)
                                {
                                    <option value="@k">@k</option>
                                }
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <label class="small text-muted mb-0">Custom image:</label>
                            <InputFile class="form-control form-control-sm"
                                       accept="image/*"
                                       OnChange="@(args => OnGroundCoverCustomTextureSelected(single!, args))" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(single!.TextureImageId))
                        {
                            <div class="x-small text-muted mb-1">Using custom image (overrides texture).
                                <button class="btn btn-link btn-sm p-0" @onclick="() => ClearGroundCoverCustomTexture(single!)">clear</button>
                            </div>
                        }
                        <div>
                            <button class="btn btn-link btn-sm p-0"
                                    @onclick="() => ResetGroundCoverToPaletteDefaults(single!)">Reset to defaults</button>
                        </div>
                    </div>
                }

                @if (!isPreview && single!.Kind == ShapeKind.SoilMarker)
                {
                    var orderedReadings = SoilMarkerAnalysis.ReadingsNewestFirst(single!.Readings);
                    <div class="soil-marker-panel mt-2 pt-2 border-top">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <div class="small fw-semibold">Soil readings</div>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => AddSoilReading(single!)">Add reading</button>
                        </div>
                        @if (orderedReadings.Count == 0)
                        {
                            <div class="x-small text-muted">No readings yet. Add one to start tracking pH, EC, and nutrients.</div>
                        }
                        else
                        {
                            @if (HasSoilSparkline(orderedReadings, r => r.PhValue) || HasSoilSparkline(orderedReadings, r => r.SalinityEcDsm))
                            {
                                <div class="soil-sparkline-row">
                                    @if (HasSoilSparkline(orderedReadings, r => r.PhValue))
                                    {
                                        <div class="soil-sparkline-item">
                                            <span class="x-small text-muted">pH</span>
                                            @((MarkupString)PlantRendering.SparklineSvg(orderedReadings, r => r.PhValue, "#7a4f1d"))
                                        </div>
                                    }
                                    @if (HasSoilSparkline(orderedReadings, r => r.SalinityEcDsm))
                                    {
                                        <div class="soil-sparkline-item">
                                            <span class="x-small text-muted">EC</span>
                                            @((MarkupString)PlantRendering.SparklineSvg(orderedReadings, r => r.SalinityEcDsm, "#2f88c0"))
                                        </div>
                                    }
                                </div>
                            }

                            <div class="soil-reading-list">
                                @foreach (var reading in orderedReadings)
                                {
                                    <div class="soil-reading-card" @key="reading">
                                        <div class="soil-reading-grid">
                                            <label>
                                                <span>Date</span>
                                                <input type="date" class="form-control form-control-sm"
                                                       value="@SoilDateValue(reading.TakenOnUtc)"
                                                       @onchange="@(e => OnSoilReadingDateChanged(single!, reading, e))" />
                                            </label>
                                            <label>
                                                <span>pH</span>
                                                <input type="number" min="0" max="14" step="0.1" class="form-control form-control-sm"
                                                       value="@SoilNumberValue(reading.PhValue)"
                                                       @onchange="@(e => OnSoilReadingNumberChanged(single!, reading, nameof(SoilReading.PhValue), e))" />
                                            </label>
                                            <label>
                                                <span>EC</span>
                                                <input type="number" min="0" step="0.1" class="form-control form-control-sm"
                                                       value="@SoilNumberValue(reading.SalinityEcDsm)"
                                                       @onchange="@(e => OnSoilReadingNumberChanged(single!, reading, nameof(SoilReading.SalinityEcDsm), e))" />
                                            </label>
                                            <label>
                                                <span>OM %</span>
                                                <input type="number" min="0" step="0.1" class="form-control form-control-sm"
                                                       value="@SoilNumberValue(reading.OrganicMatterPct)"
                                                       @onchange="@(e => OnSoilReadingNumberChanged(single!, reading, nameof(SoilReading.OrganicMatterPct), e))" />
                                            </label>
                                            <label>
                                                <span>N ppm</span>
                                                <input type="number" min="0" step="0.1" class="form-control form-control-sm"
                                                       value="@SoilNumberValue(reading.NitrogenPpm)"
                                                       @onchange="@(e => OnSoilReadingNumberChanged(single!, reading, nameof(SoilReading.NitrogenPpm), e))" />
                                            </label>
                                            <label>
                                                <span>P ppm</span>
                                                <input type="number" min="0" step="0.1" class="form-control form-control-sm"
                                                       value="@SoilNumberValue(reading.PhosphorusPpm)"
                                                       @onchange="@(e => OnSoilReadingNumberChanged(single!, reading, nameof(SoilReading.PhosphorusPpm), e))" />
                                            </label>
                                            <label>
                                                <span>K ppm</span>
                                                <input type="number" min="0" step="0.1" class="form-control form-control-sm"
                                                       value="@SoilNumberValue(reading.PotassiumPpm)"
                                                       @onchange="@(e => OnSoilReadingNumberChanged(single!, reading, nameof(SoilReading.PotassiumPpm), e))" />
                                            </label>
                                            <label>
                                                <span>Lab</span>
                                                <input type="text" class="form-control form-control-sm"
                                                       value="@(reading.LabSource ?? string.Empty)"
                                                       @onchange="@(e => OnSoilReadingTextChanged(single!, reading, nameof(SoilReading.LabSource), e))" />
                                            </label>
                                        </div>
                                        <div class="soil-reading-grid soil-reading-grid-notes mt-2">
                                            <label>
                                                <span>Drainage</span>
                                                <input type="text" class="form-control form-control-sm"
                                                       value="@(reading.DrainageNotes ?? string.Empty)"
                                                       @onchange="@(e => OnSoilReadingTextChanged(single!, reading, nameof(SoilReading.DrainageNotes), e))" />
                                            </label>
                                            <label>
                                                <span>Notes</span>
                                                <input type="text" class="form-control form-control-sm"
                                                       value="@(reading.GeneralNotes ?? string.Empty)"
                                                       @onchange="@(e => OnSoilReadingTextChanged(single!, reading, nameof(SoilReading.GeneralNotes), e))" />
                                            </label>
                                        </div>
                                        <div class="soil-reading-actions">
                                            <span class="x-small text-muted">Latest-first order</span>
                                            <button class="btn btn-link btn-sm p-0 text-danger" @onclick="() => DeleteSoilReading(single!, reading)">Delete</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (!isPreview && CanShapeBeClipped(single!))
                {
                    var clipCandidates = ClipCandidatesFor(single!);
                    <div class="clip-info mt-2 pt-2 border-top">
                        <div class="small fw-semibold mb-1">Clipped by</div>
                        <div class="small mb-2"><strong>@ClipAreaSummary(single!)</strong></div>
                        @if (clipCandidates.Count == 0)
                        {
                            <div class="x-small text-muted">No other area shapes are available on this plot.</div>
                        }
                        else
                        {
                            <div class="clip-candidate-list">
                                @foreach (var candidate in clipCandidates)
                                {
                                    <label class="clip-candidate-row">
                                        <input type="checkbox"
                                               checked="@candidate.Selected"
                                               @onchange="@(e => OnClipCandidateChanged(single!, candidate.Id, e))" />
                                        <span>@candidate.Label</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                }

                @if (!isPreview && isSingle && single is not null && CanBindTasks(single))
                {
                    <div class="mt-2 pt-2 border-top">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <div class="small fw-semibold">Tasks</div>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => BeginNewTask(single!)">+ Add task</button>
                        </div>

                        @if (singleShapeTasks.Count == 0)
                        {
                            <div class="x-small text-muted mb-2">No tasks for this item yet.</div>
                        }
                        else
                        {
                            <ul class="list-unstyled small mb-2">
                                @foreach (GardenTask task in singleShapeTasks)
                                {
                                    <li class="mb-2 pb-2 border-bottom">
                                        <div class="d-flex align-items-start justify-content-between gap-2">
                                            <div>
                                                <div class="fw-semibold">@task.Title</div>
                                                <div class="x-small text-muted">
                                                    @GardenTaskScheduler.GetCadenceLabel(task)
                                                    @if (task.NextDueUtc is { } nextDueUtc)
                                                    {
                                                        <span> · due @FormatTaskDue(nextDueUtc)</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(task.Notes))
                                                {
                                                    <div class="x-small text-muted">@task.Notes</div>
                                                }
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-link p-0" @onclick="() => EditTask(task)">Edit</button>
                                                <button class="btn btn-sm btn-link p-0 text-danger" @onclick="() => DeleteTaskAsync(task.Id)">Delete</button>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }

                        @if (singleTaskTemplates.Count > 0)
                        {
                            <div class="x-small text-muted mb-1">Suggested templates</div>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @foreach (GardenTaskTemplate template in singleTaskTemplates)
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => UseTaskTemplate(single!, template)">@template.Title</button>
                                }
                            </div>
                        }

                        @if (TaskEditorMatchesShape(single.Id))
                        {
                            <div class="border rounded p-2 bg-body-tertiary">
                                <div class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label form-label-sm mb-1">Title</label>
                                        <input class="form-control form-control-sm" @bind="taskDraftTitle" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label form-label-sm mb-1">Cadence</label>
                                        <InputSelect class="form-select form-select-sm" @bind-Value="taskDraftCadence">
                                            @foreach (TaskCadence cadence in Enum.GetValues<TaskCadence>())
                                            {
                                                <option value="@cadence">@cadence</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label form-label-sm mb-1">Next due</label>
                                        <input type="datetime-local" class="form-control form-control-sm" value="@taskDraftNextDueLocal" @onchange="OnTaskDueChanged" />
                                    </div>
                                    @if (taskDraftCadence is TaskCadence.SeasonStart or TaskCadence.SeasonEnd)
                                    {
                                        <div class="col-sm-6">
                                            <label class="form-label form-label-sm mb-1">Season</label>
                                            <InputSelect class="form-select form-select-sm" @bind-Value="taskDraftSeason">
                                                @foreach (Season season in Enum.GetValues<Season>())
                                                {
                                                    <option value="@season">@season</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    }
                                    @if (taskDraftCadence == TaskCadence.Custom)
                                    {
                                        <div class="col-sm-6">
                                            <label class="form-label form-label-sm mb-1">Custom cron</label>
                                            <input class="form-control form-control-sm" @bind="taskDraftCustomCron" placeholder="0 8 * * 1" />
                                        </div>
                                    }
                                    <div class="col-12">
                                        <label class="form-label form-label-sm mb-1">Notes</label>
                                        <textarea class="form-control form-control-sm" rows="2" @bind="taskDraftNotes"></textarea>
                                        <div class="x-small text-muted mt-1">Leave next due blank to auto-schedule from the cadence.</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn btn-sm btn-primary" @onclick="SaveTaskAsync" disabled="@string.IsNullOrWhiteSpace(taskDraftTitle)">Save task</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelTaskEdit">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (isPreview && previewDropPattern != DropPattern.One)
                {
                    <div class="small"><span class="text-muted">Drop pattern:</span> <strong>@previewDropPattern</strong></div>
                    <div class="small"><span class="text-muted">Orientation:</span> <strong>@F(stampOrientation)°</strong></div>
                    <div class="small"><span class="text-muted">Item rotation:</span> <strong>@F(stampRotation)°</strong></div>
                    <div class="x-small text-muted">Wheel controls: Shift/Ctrl rotate items, Alt rotates line/array orientation. Shift+Ctrl or the array auto-shift toggle keeps legacy nudging.</div>
                }
            }
            else
            {
                <div class="small text-muted mb-1">Selected items:</div>
                <ul class="selection-list small">
                    @foreach (var grp in selShapes
                                          .GroupBy(s => (Kind: TakeoffKind(s), Name: TakeoffName(s)))
                                          .OrderBy(g => g.Key.Kind, StringComparer.Ordinal)
                                          .ThenBy(g => g.Key.Name, StringComparer.Ordinal))
                    {
                        <li class="selection-item-row">
                            <span class="selection-item-text">
                                <span class="text-muted">@grp.Key.Kind:</span>
                                <strong>@grp.Key.Name</strong>
                                @if (grp.Count() > 1)
                                {
                                    <span class="text-muted">× @grp.Count()</span>
                                }
                            </span>
                            <button class="selection-remove-btn"
                                    title="Remove these items from selection"
                                    @onclick='() => RemoveSelectionGroup(grp.Key.Kind, grp.Key.Name)'>×</button>
                        </li>
                    }
                </ul>

                var rotationValues = selShapes.Select(s => Math.Round(s.Rotation, 3)).Distinct().ToList();
                var rotationSingleValue = rotationValues.Count == 1 ? rotationValues[0] : (double?)null;
                <div class="rotation-edit-row mt-1">
                    <span class="text-muted small">Rotation:</span>
                    <input type="number" class="form-control form-control-sm rotation-input"
                           min="0" max="360" step="1"
                           value="@(rotationSingleValue is double rv ? F(rv) : string.Empty)"
                           placeholder="@(rotationSingleValue is null ? "(mixed)" : string.Empty)"
                           @onchange="(e) => OnShapeRotationInputChanged(selShapes, e)" />
                    <span class="small text-muted">°</span>
                    <div class="rotation-quickset btn-group btn-group-sm" role="group" aria-label="Quick rotation values">
                        @foreach (double q in QuickRotationDegrees)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => QuickSetShapeRotationAsync(selShapes, q)">@F(q)°</button>
                        }
                    </div>
                </div>
                @if (selShapes.All(IsGroundCoverShape))
                {
                    var materialNames = selShapes.Select(CatalogService.MaterialDisplayName).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                    <div class="ground-cover-info mt-2 pt-2 border-top">
                        <div class="small fw-semibold mb-1">Ground cover</div>
                        <div class="small d-flex align-items-center gap-2 flex-wrap">
                            <span class="text-muted">Material:</span>
                            <strong>@(materialNames.Count == 1 ? materialNames[0] : "(mixed)")</strong>
                            <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="ShowMaterialPickerForSelection">Change…</button>
                        </div>
                    </div>
                }
            }

            @if (!isPreview && selectedDropGroup is null && singleDropGroup is not null)
            {
                <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => SelectDropGroupFromPanel(singleDropGroup.Id)">Select drop group</button>
            }

            @if (!isPreview && selectedDropGroup is not null)
            {
                <hr class="my-2" />
                <div class="fw-bold small mb-1">Drop group layout</div>
                <div class="group-edit-grid">
                    <label>Pattern</label>
                    <div><strong>@selectedDropGroup.Pattern</strong> · @groupMembers.Count items</div>

                    @if (selectedDropGroup.Pattern == DropPattern.AlongPath)
                    {
                        <label>Rotation</label>
                        <div class="rotation-edit-row">
                            @if (selectedDropGroup.AlignToTangent)
                            {
                                <strong class="small">Path tangent</strong>
                            }
                            else
                            {
                                <input type="number" class="form-control form-control-sm rotation-input"
                                       min="0" max="360" step="1"
                                       value="@F(selectedDropGroup.Rotation)"
                                       @onchange="(e) => OnDropGroupRotationInputChanged(selectedDropGroup, e)" />
                                <span class="small text-muted">°</span>
                                <div class="rotation-quickset btn-group btn-group-sm" role="group" aria-label="Quick orientation values">
                                    @foreach (double q in QuickRotationDegrees)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                @onclick="() => QuickSetDropGroupRotationAsync(selectedDropGroup, q)">@F(q)°</button>
                                    }
                                </div>
                            }
                        </div>

                        <label>Source path</label>
                        <div>
                            <strong>@F(groupLength) ft</strong>
                            <button class="btn btn-link btn-sm p-0 ms-2" @onclick="() => SelectAlongPathSource(selectedDropGroup)">select</button>
                        </div>

                        <label>Spacing (ft)</label>
                        <input type="number" min="0.1" max="200" step="0.1" value="@groupSpacingOverrideValue" placeholder="@F(groupCenterSpacingX)" @onchange="OnAlongPathSpacingOverrideChanged" />

                        <label>Offset (in)</label>
                        <input type="number" min="-240" max="240" step="0.5" value="@groupOffsetValue" @onchange="OnAlongPathOffsetChanged" />

                        <label>Anchor</label>
                        <select @onchange="OnAlongPathAnchorChanged" value="@selectedDropGroup.Anchor">
                            @foreach (var anchor in Enum.GetValues<AlongPathAnchor>())
                            {
                                <option value="@anchor">@anchor</option>
                            }
                        </select>

                        <label>Align</label>
                        <label class="small"><input type="checkbox" checked="@selectedDropGroup.AlignToTangent" @onchange="OnAlongPathAlignChanged" /> Tangent rotation</label>
                    }
                    else
                    {
                        <label>Orientation</label>
                        <div class="rotation-edit-row">
                            <input type="number" class="form-control form-control-sm rotation-input"
                                   min="0" max="360" step="1"
                                   value="@F(selectedDropGroup.Rotation)"
                                   @onchange="(e) => OnDropGroupRotationInputChanged(selectedDropGroup, e)" />
                            <span class="small text-muted">°</span>
                            <div class="rotation-quickset btn-group btn-group-sm" role="group" aria-label="Quick orientation values">
                                @foreach (double q in QuickRotationDegrees)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => QuickSetDropGroupRotationAsync(selectedDropGroup, q)">@F(q)°</button>
                                }
                            </div>
                        </div>

                        <label>Length (ft)</label>
                        <input type="number" min="0" max="500" step="0.1" value="@F(groupLength)" @onchange="OnGroupLengthChanged" />

                        <label>Center X (ft)</label>
                        <input type="number" min="0.1" max="200" step="0.1" value="@F(groupCenterSpacingX)" @onchange="(e) => OnGroupCenterSpacingChanged(e, true)" />

                        <label>Gap X (ft)</label>
                        <input type="number" min="-200" max="200" step="0.1" value="@F(groupGapX)" @onchange="(e) => OnGroupBoundingSpacingChanged(e, true)" />

                        @if (selectedDropGroup.Pattern == DropPattern.Array)
                        {
                            <label>Rows</label>
                            <input type="number" min="1" max="@Math.Max(1, groupMembers.Count)" step="1" value="@selectedDropGroup.Rows" @onchange="OnGroupRowsChanged" />

                            <label>Center Y (ft)</label>
                            <input type="number" min="0.1" max="200" step="0.1" value="@F(groupCenterSpacingY)" @onchange="(e) => OnGroupCenterSpacingChanged(e, false)" />

                            <label>Gap Y (ft)</label>
                            <input type="number" min="-200" max="200" step="0.1" value="@F(groupGapY)" @onchange="(e) => OnGroupBoundingSpacingChanged(e, false)" />

                            <label>Triangulated</label>
                            <label class="small" title="Offsets every other row by half an X spacing. With Center Y = 0, rows become equilateral."><input type="checkbox" checked="@selectedDropGroup.Triangulated" @onchange="OnGroupTriangulatedChanged" /> Triangulated</label>
                        }
                    }
                </div>
            }

            @if (!isPreview && (customizable.Count > 0 || fontCustomizable.Count > 0))
            {
                <hr class="my-2" />
                <div class="fw-bold small mb-1">Appearance</div>
                @if (customizable.Count > 0)
                {
                    <div class="color-row">
                        <label class="small">Line</label>
                        <input type="color" value="@strokeValue" @onchange="OnStrokeChanged"
                               class="@(strokeMixed ? "mixed" : "")" title="@(strokeMixed ? "Mixed values — pick to unify" : strokeValue)" />
                        @if (strokeMixed) { <span class="x-small text-muted">(mixed)</span> }
                    </div>
                    <div class="color-row">
                        <label class="small">Fill</label>
                        <input type="color" value="@fillValue" @onchange="OnFillChanged"
                               class="@(fillMixed ? "mixed" : "")" title="@(fillMixed ? "Mixed values — pick to unify" : fillValue)" />
                        @if (fillMixed) { <span class="x-small text-muted">(mixed)</span> }
                    </div>
                    <div class="color-row">
                        <label class="small">Opacity</label>
                        <input type="range" min="0" max="1" step="0.05" value="@F(opValue)" @oninput="OnFillOpacityChanged"
                               class="@(opMixed ? "mixed" : "")" />
                        <span class="x-small text-muted">@(opMixed ? "(mixed)" : $"{opValue * 100:0}%")</span>
                    </div>
                }
                @if (fontCustomizable.Count > 0)
                {
                    <div class="color-row">
                        <label class="small">Font</label>
                        <input type="range" min="0.5" max="3" step="0.05" value="@F(fontValue)" @oninput="OnFontScaleChanged"
                               class="@(fontMixed ? "mixed" : "")" />
                        <span class="x-small text-muted">@(fontMixed ? "(mixed)" : $"{fontValue * 100:0}%")</span>
                    </div>
                }
                @if (customizable.Count > 0)
                {
                    <button class="btn btn-sm btn-link p-0 small me-2" @onclick="ResetSelectedColors">Reset colors</button>
                }
                @if (fontCustomizable.Count > 0)
                {
                    <button class="btn btn-sm btn-link p-0 small" @onclick="ResetSelectedFont">Reset font</button>
                }
            }
            else if (!isPreview && selShapes.Count > 0)
            {
                <hr class="my-2" />
                <div class="x-small text-muted">
                    Appearance customization is not available for this item.
                </div>
            }

            @if (isSingle && ProfileForShape(single!, isPreview) is { } profile)
            {
                <hr class="my-2" />
                <div class="plant-profile">
                    @if (!string.IsNullOrWhiteSpace(profile.ScientificName))
                    {
                        <div class="x-small"><em>@profile.ScientificName</em>@(string.IsNullOrWhiteSpace(profile.Family) ? "" : $" · {profile.Family}")</div>
                    }
                    <div class="badge-row">
                        @if (profile.Hardiness is { } hz)
                        {
                            <span class="badge badge-hardiness" title="USDA hardiness zones">❄ Zones @hz.MinZone–@hz.MaxZone</span>
                        }
                        @if (profile.LightTolerance is { Length: > 0 } lights)
                        {
                            <span class="badge badge-sun-full" title="Light tolerance">☀ @string.Join(" / ", lights.Select(LightLabel))</span>
                        }
                        @if (profile.Water is { } w)
                        {
                            <span class="badge badge-water-@(w.ToString().ToLowerInvariant())">💧 @w water</span>
                        }
                        @if (profile.DroughtTolerant)
                        {
                            <span class="badge badge-drought" title="Drought tolerant">drought ok</span>
                        }
                        @if (profile.FrostSensitive)
                        {
                            <span class="badge badge-frost" title="Frost sensitive">frost-sensitive</span>
                        }
                        @if (profile.Evergreen)
                        {
                            <span class="badge badge-evergreen">evergreen</span>
                        }
                        @if (profile.DeerResistant)
                        {
                            <span class="badge badge-deer">deer-resistant</span>
                        }
                        @if (profile.RabbitResistant)
                        {
                            <span class="badge badge-rabbit">rabbit-resistant</span>
                        }
                        @if (profile.Thorns)
                        {
                            <span class="badge badge-warning" title="Has thorns or sharp parts">⚠ thorns</span>
                        }
                        @if (profile.Invasive)
                        {
                            <span class="badge badge-danger" title="Considered invasive in some regions">⚠ invasive</span>
                        }
                    </div>
                    @if (profile.Toxicity is { } tox && (tox.ToCats != ToxicityLevel.None || tox.ToDogs != ToxicityLevel.None || tox.ToHumans != ToxicityLevel.None))
                    {
                        <div class="tox-block">
                            <div class="x-small text-muted mb-1">Toxicity</div>
                            <div class="tox-rows">
                                @if (tox.ToCats != ToxicityLevel.None)
                                {
                                    <span class="tox-row tox-@(tox.ToCats.ToString().ToLowerInvariant())" title="@($"Toxic to cats: {tox.ToCats}")">
                                        <span class="tox-icon">🐈</span><span class="tox-no">⃠</span>
                                        <span class="x-small">Cats · @tox.ToCats</span>
                                    </span>
                                }
                                @if (tox.ToDogs != ToxicityLevel.None)
                                {
                                    <span class="tox-row tox-@(tox.ToDogs.ToString().ToLowerInvariant())" title="@($"Toxic to dogs: {tox.ToDogs}")">
                                        <span class="tox-icon">🐕</span><span class="tox-no">⃠</span>
                                        <span class="x-small">Dogs · @tox.ToDogs</span>
                                    </span>
                                }
                                @if (tox.ToHumans != ToxicityLevel.None)
                                {
                                    <span class="tox-row tox-@(tox.ToHumans.ToString().ToLowerInvariant())" title="@($"Toxic to humans: {tox.ToHumans}")">
                                        <span class="tox-icon">🧑</span><span class="tox-no">⃠</span>
                                        <span class="x-small">Humans · @tox.ToHumans</span>
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(tox.Notes))
                            {
                                <div class="x-small text-muted mt-1">@tox.Notes</div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(profile.NoxiousStatus))
                    {
                        <div class="x-small text-warning mt-1">@profile.NoxiousStatus</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(profile.Description))
                    {
                        <div class="x-small mt-1">@profile.Description</div>
                    }
                    @if (profile.Sources is { Length: > 0 } srcs)
                    {
                        <div class="x-small text-muted mt-1">
                            Sources:
                            @for (int i = 0; i < srcs.Length; i++)
                            {
                                var s = srcs[i];
                                if (i > 0)
                                {
                                    <text>, </text>
                                }
                                @if (!string.IsNullOrWhiteSpace(s.Url))
                                {
                                    <a href="@s.Url" target="_blank" rel="noopener">@s.Source</a>
                                }
                                else
                                {
                                    @s.Source
                                }
                            }
                        </div>
                    }
                </div>
            }

            @if (isSingle && !isPreview && IsPlantLikeShape(single!))
            {
                var soilMatch = SoilMarkerAnalysis.FindNearestMarker(single!, currentPlot.Shapes, ProfileForShape(single!, isPreview));
                <hr class="my-2" />
                <div class="fw-bold small mb-1">Soil alignment</div>
                @if (soilMatch is null)
                {
                    <div class="x-small text-muted">No soil marker within @F(SoilMarkerAnalysis.DefaultAlignmentRadiusFt) ft.</div>
                }
                else
                {
                    <div class="small"><span class="text-muted">Nearest marker:</span> <strong>@SoilMarkerName(soilMatch.Marker)</strong> <span class="text-muted">— @F(soilMatch.DistanceFt) ft</span></div>
                    @if (soilMatch.LatestReading is { } recentReading)
                    {
                        <div class="soil-reading-inline mt-1 x-small">
                            <span><strong>@recentReading.TakenOnUtc:yyyy-MM-dd</strong></span>
                            @if (recentReading.PhValue is double phValue)
                            {
                                <span>pH <strong>@phValue.ToString("0.##", CultureInfo.InvariantCulture)</strong></span>
                            }
                            @if (recentReading.SalinityEcDsm is double ecValue)
                            {
                                <span>EC <strong>@ecValue.ToString("0.##", CultureInfo.InvariantCulture)</strong> dS/m</span>
                            }
                            @if (recentReading.OrganicMatterPct is double organicMatter)
                            {
                                <span>OM <strong>@organicMatter.ToString("0.##", CultureInfo.InvariantCulture)</strong>%</span>
                            }
                        </div>
                        @if (soilMatch.IsPhMismatch)
                        {
                            <div class="soil-warning x-small mt-1">Latest pH @recentReading.PhValue?.ToString("0.##", CultureInfo.InvariantCulture) is outside the preferred range @FormatSoilPhRange(soilMatch.PreferredPhRange).</div>
                        }
                    }
                    else
                    {
                        <div class="x-small text-muted mt-1">Nearest marker has no readings yet.</div>
                    }
                }
            }

            @if (isSingle && (single!.Kind == ShapeKind.Tree || single.Kind == ShapeKind.Bush || IsTileShape(single)))
            {
                <hr class="my-2" />
                @if (wikiLoading)
                {
                    <div class="x-small text-muted">Loading Wikipedia summary…</div>
                }
                else if (wikiSummary is not null)
                {
                    <div class="wiki-block">
                        @if (!string.IsNullOrEmpty(wikiSummary.ThumbnailUrl))
                        {
                            <img class="wiki-thumb" src="@wikiSummary.ThumbnailUrl" alt="@wikiSummary.Title" />
                        }
                        <div class="fw-bold small">@wikiSummary.Title</div>
                        <div class="x-small wiki-extract">@wikiSummary.Extract</div>
                        <a class="x-small" href="@wikiSummary.PageUrl" target="_blank" rel="noopener">
                            Read more on Wikipedia →
                        </a>
                    </div>
                }
                else
                {
                    var topic = WikipediaTopic(single.Label ?? "");
                    var searchUrl = $"https://en.wikipedia.org/w/index.php?search={System.Net.WebUtility.UrlEncode(topic)}";
                    <div class="x-small text-muted">No Wikipedia summary found.</div>
                    <a class="x-small" href="@searchUrl" target="_blank" rel="noopener">Search Wikipedia →</a>
                }
            }

            @if (isSingle && ResolveCustomTileInfoItem(single!, isPreview) is { } customInfo)
            {
                <hr class="my-2" />
                @if (!string.IsNullOrWhiteSpace(customInfo.TilePreviewImageFileName))
                {
                    <img class="wiki-thumb" src="@TileImageUrl(customInfo.TilePreviewImageFileName!)" data-client-image-id="@TileImageClientId(customInfo.TilePreviewImageFileName)" alt="@customInfo.Code" />
                }

                @if (customTileCitationLoading)
                {
                    <div class="x-small text-muted">Loading citation details…</div>
                }
                else if (customTileCitation is not null)
                {
                    <div class="wiki-block">
                        @if (!string.IsNullOrEmpty(customTileCitation.ImageUrl))
                        {
                            <img class="wiki-thumb" src="@customTileCitation.ImageUrl" alt="@customTileCitation.Title" />
                        }
                        <div class="fw-bold small">@customTileCitation.Title</div>
                        @if (!string.IsNullOrWhiteSpace(customTileCitation.Extract))
                        {
                            <div class="x-small wiki-extract">@customTileCitation.Extract</div>
                        }
                        <a class="x-small" href="@customTileCitation.PageUrl" target="_blank" rel="noopener">Open source page →</a>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(customInfo.CitationUrl))
                {
                    <a class="x-small" href="@customInfo.CitationUrl" target="_blank" rel="noopener">Open source page →</a>
                }
            }

            @if (isSingle && single!.Kind == ShapeKind.Plant && !IsFocalPointTrait(single!.Trait))
            {
                var rules = CompanionRules.ForCode(single.Label ?? "");
                var nearby = isPreview ? new List<(Shape other, double distFt)>() : NearbyPlants(single, currentPlot.Shapes);
                <hr class="my-2" />
                @if (!isPreview)
                {
                    <div class="fw-bold small mb-1">Companions nearby</div>
                    @if (nearby.Count == 0)
                    {
                        <div class="x-small text-muted">No other plants within 2× spacing.</div>
                    }
                    else
                    {
                        <ul class="companion-list small">
                            @foreach (var (other, distFt) in nearby)
                            {
                                var otherName = other.Label ?? "";
                                var verdict = rules.good.Any(g => string.Equals(g, otherName, StringComparison.OrdinalIgnoreCase)) ? "good"
                                            : rules.bad.Any(b => string.Equals(b, otherName, StringComparison.OrdinalIgnoreCase))  ? "bad"
                                            : "neutral";
                                <li class="comp-@verdict">
                                    <span class="comp-marker"></span>
                                    <strong>@otherName</strong>
                                    <span class="text-muted">— @F(distFt) ft</span>
                                </li>
                            }
                        </ul>
                    }
                }
                @if (rules.good.Count > 0 || rules.bad.Count > 0)
                {
                    <div class="x-small text-muted mt-2">
                        @if (rules.good.Count > 0)
                        {
                            <div><strong>Plant near:</strong> @string.Join(", ", rules.good)</div>
                        }
                        @if (rules.bad.Count > 0)
                        {
                            <div><strong>Avoid:</strong> @string.Join(", ", rules.bad)</div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@if (showNewPlotDialog)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog @(string.IsNullOrWhiteSpace(newPlotBackgroundImageFileName) ? string.Empty : "modal-xl")" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditingPlotSettings ? "Edit Garden Plot" : "New Garden Plot")</h5>
                    <button type="button" class="btn-close" @onclick="CancelNewPlot"></button>
                </div>
                <div class="modal-body">
                    @if (!isEditingPlotSettings && newPlotDialogStep == NewPlotDialogStep.ImageFirst)
                    {
                        <div class="small text-muted mb-2">Step 1 of 2 &middot; Start with a background image, or skip to manual dimensions.</div>
                        <div class="mb-2">
                            <label class="form-label small">Background image</label>
                            <InputFile OnChange="OnPlotBackgroundImageSelected" accept="image/*" class="form-control form-control-sm" />
                            @if (!string.IsNullOrWhiteSpace(newPlotBackgroundImageWarning))
                            {
                                <div class="x-small text-warning mt-1">@newPlotBackgroundImageWarning</div>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ContinueWithoutPlotImage">No image, enter dimensions manually</button>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">
                            @(isEditingPlotSettings
                                ? "Update the saved plot size and display units."
                                : newPlotDimensionsDerivedFromImage
                                    ? "Step 2 of 2 · Review the size derived from your image."
                                    : "Step 2 of 2 · Enter plot dimensions manually.")
                        </div>

                        <div class="mb-2">
                            <label class="form-label small">Name</label>
                            <input class="form-control form-control-sm" @bind="newPlotName" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Shape</label>
                            <select class="form-select form-select-sm" @bind="newPlotShape">
                                <option value="Rectangle">Rectangle (flat)</option>
                            </select>
                        </div>

                        <div class="row g-2 plot-dimension-row align-items-end">
                            <div class="col plot-dimension-col">
                                <label class="form-label small">Width (@LinearUnitShortLabel(newPlotLinearUnit))</label>
                                <input type="number" min="1" max="6000" step="0.1" class="form-control form-control-sm"
                                       @bind="NewPlotWidthDisplay" />
                            </div>
                            <div class="col-auto plot-dimension-lock-col">
                                <button type="button"
                                        class="aspect-lock-toggle @(aspectLocked ? "locked" : string.Empty)"
                                        @onclick="ToggleAspectLock"
                                        aria-label="Lock aspect ratio"
                                        aria-pressed="@aspectLocked"
                                        title="Lock aspect ratio">
                                    @if (aspectLocked)
                                    {
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path fill="currentColor" d="M14.41 4.76C15.96 3.21 18.49 3.21 20.04 4.76C21.59 6.32 21.59 8.84 20.04 10.4L17.76 12.68C16.21 14.23 13.68 14.23 12.12 12.68L11.56 12.12L13.26 10.42L13.83 10.98C14.44 11.6 15.44 11.6 16.06 10.98L18.34 8.7C18.96 8.08 18.96 7.08 18.34 6.46C17.72 5.84 16.72 5.84 16.1 6.46L13.82 8.74L12.12 7.04ZM11.88 11.32L12.44 11.88L10.74 13.58L10.17 13.02C9.56 12.4 8.56 12.4 7.94 13.02L5.66 15.3C5.04 15.92 5.04 16.92 5.66 17.54C6.28 18.16 7.28 18.16 7.9 17.54L10.18 15.26L11.88 16.96L9.59 19.24C8.04 20.79 5.51 20.79 3.96 19.24C2.41 17.68 2.41 15.16 3.96 13.6L6.24 11.32C7.79 9.77 10.32 9.77 11.88 11.32ZM8.54 11.88L11.88 8.54L15.46 12.12L12.12 15.46Z" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M10.6 13.4C9.43 12.23 9.43 10.34 10.6 9.17L13.17 6.6C14.34 5.43 16.23 5.43 17.4 6.6C18.57 7.77 18.57 9.66 17.4 10.83L15.9 12.33" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M13.4 10.6C14.57 11.77 14.57 13.66 13.4 14.83L10.83 17.4C9.66 18.57 7.77 18.57 6.6 17.4C5.43 16.23 5.43 14.34 6.6 13.17L8.1 11.67" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    }
                                </button>
                            </div>
                            <div class="col plot-dimension-col">
                                <label class="form-label small">Height (@LinearUnitShortLabel(newPlotLinearUnit))</label>
                                <input type="number" min="1" max="6000" step="0.1" class="form-control form-control-sm"
                                       @bind="NewPlotHeightDisplay" />
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label small">Units</label>
                                <select class="form-select form-select-sm" @bind="newPlotLinearUnit" disabled="@newPlotLinearUnitReadOnly">
                                    @foreach (var unit in Enum.GetValues<LinearUnit>())
                                    {
                                        <option value="@unit">@LinearUnitShortLabel(unit)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-3 mt-2">
                            <span class="x-small text-muted">Stored as @F(newPlotWidth) × @F(newPlotHeight) ft</span>
                            @if (newPlotDimensionsDerivedFromImage && newPlotImagePixelWidth is not null && newPlotImagePixelHeight is not null)
                            {
                                <span class="x-small text-muted">Derived from @newPlotImagePixelWidth × @newPlotImagePixelHeight px at @F(DefaultPlotPixelsPerFoot) px/ft.</span>
                            }
                        </div>
                        @if (newPlotLinearUnitReadOnly)
                        {
                            <div class="x-small text-muted mt-1">Legacy plots default to feet until they are saved with an explicit unit.</div>
                        }

                        @if (ShowRecentPlotSizeQuickPicks)
                        {
                            <div class="mt-2">
                                <label class="form-label x-small">Recent sizes</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var size in library.Ui.RecentPlotSizes.Take(10))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => ApplyRecentPlotSize(size))">@RecentPlotSizeLabel(size)</button>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mb-2 mt-3">
                            <label class="form-label small">Background image</label>
                            <InputFile OnChange="OnPlotBackgroundImageSelected" accept="image/*" class="form-control form-control-sm" />
                            @if (!string.IsNullOrWhiteSpace(newPlotBackgroundImageWarning))
                            {
                                <div class="x-small text-warning mt-1">@newPlotBackgroundImageWarning</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(newPlotBackgroundImageFileName))
                            {
                                <div class="row g-2 mt-2">
                                    <div class="col">
                                        <label class="form-label x-small">Background opacity</label>
                                        <input type="range" min="0" max="1" step="0.05" class="form-range"
                                               @bind="newPlotBackgroundOpacity" />
                                        <div class="x-small text-muted">@F(newPlotBackgroundOpacity * 100)%</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 mt-2 flex-wrap">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearPlotBackgroundImage">Remove image</button>
                                    @if (isEditingPlotSettings)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="BeginScaleCalibrationFromDialog">Scale</button>
                                        <span class="x-small text-muted">Use Scale on the main canvas to refine the fit.</span>
                                    }
                                    else
                                    {
                                        <span class="x-small text-muted">Create the plot first, then use Scale on the main canvas if you need to refine it.</span>
                                    }
                                </div>
                                <img class="plot-calibration-image mt-2"
                                     src="@PlotImageUrl(newPlotBackgroundImageFileName!)"
                                     alt="Plot background calibration preview" />
                            }
                        </div>

                        <div class="mb-2">
                            <label class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" @bind="newPlotShowGrid" />
                                <span class="form-check-label small">Show grid</span>
                            </label>

                            @if (newPlotShowGrid)
                            {
                                <div class="row g-2">
                                    <div class="col-4">
                                        <label class="form-label x-small">Line color</label>
                                        <input type="color" class="form-control form-control-sm form-control-color custom-color" @bind="newPlotGridColor" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label x-small">Line width</label>
                                        <input type="number" min="0.001" max="0.2" step="0.001" class="form-control form-control-sm" @bind="newPlotGridLineWidth" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label x-small">Opacity</label>
                                        <input type="number" min="0" max="1" step="0.05" class="form-control form-control-sm" @bind="newPlotGridOpacity" />
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mb-2">
                            <label class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" @bind="newPlotShowScaleDisplay" />
                                <span class="form-check-label small">Show scale display on canvas</span>
                            </label>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(newPlotError))
                    {
                        <div class="small text-danger mt-2">@newPlotError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CancelNewPlot">Cancel</button>
                    @if (!isEditingPlotSettings && newPlotDialogStep == NewPlotDialogStep.ImageFirst)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="ContinueWithoutPlotImage">Next</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-primary" @onclick="SavePlotSettingsAsync">@(isEditingPlotSettings ? "Save" : "Create")</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (showAddCustomTileDialog)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@CustomPaletteDialogTitle</h5>
                    <button type="button" class="btn-close" @onclick="CancelAddCustomTile"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Name</label>
                        <input class="form-control form-control-sm" @bind="newCustomTileName" />
                    </div>
                    @if (IsCustomFocalPointDialog)
                    {
                        <div class="mb-2">
                            <label class="form-label small">Icon style</label>
                            <select class="form-select form-select-sm" @bind="newCustomFocalPointTrait">
                                @foreach (var option in FocalPointTraitOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div class="x-small text-muted">Custom focal points place as single-drop tagged icons and inherit Focal Point takeoff defaults.</div>
                    }
                    else
                    {
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <label class="form-label small">Shape</label>
                                <select class="form-select form-select-sm" @bind="newCustomTileShape">
                                    <option value="Rectangle">Rectangle</option>
                                    <option value="Oval">Oval</option>
                                </select>
                            </div>
                            <div class="col">
                                <label class="form-label small">Line color</label>
                                <input type="color" class="form-control form-control-sm form-control-color custom-color" @bind="newCustomTileStrokeColor" />
                            </div>
                            <div class="col">
                                <label class="form-label small">Fill color</label>
                                <input type="color" class="form-control form-control-sm form-control-color custom-color" @bind="newCustomTileFillColor" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <label class="form-label small">Width (ft)</label>
                                <input type="number" min="0.1" max="200" step="0.1" class="form-control form-control-sm" @bind="newCustomTileWidthFt" />
                            </div>
                            <div class="col">
                                <label class="form-label small">Height (ft)</label>
                                <input type="number" min="0.1" max="200" step="0.1" class="form-control form-control-sm" @bind="newCustomTileHeightFt" />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Palette tile image (for button)</label>
                            <InputFile OnChange="OnCustomTilePreviewImageSelected" accept="image/*" class="form-control form-control-sm" />
                            @if (!string.IsNullOrWhiteSpace(newCustomTilePreviewImageWarning))
                            {
                                <div class="x-small text-warning mt-1">@newCustomTilePreviewImageWarning</div>
                            }
                        </div>
                        <label class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" @bind="newCustomTileUseButtonImageForBackground" />
                            <span class="form-check-label small">Use button image for tile background</span>
                        </label>
                        <div class="mb-2">
                            <label class="form-label small">Tile background image (for drawn shape)</label>
                            <InputFile OnChange="OnCustomTileBackgroundImageSelected" accept="image/*" class="form-control form-control-sm" disabled="@newCustomTileUseButtonImageForBackground" />
                            @if (newCustomTileUseButtonImageForBackground)
                            {
                                <div class="x-small text-muted mt-1">The drawn tile will reuse the button image.</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(newCustomTileBackgroundImageWarning))
                            {
                                <div class="x-small text-warning mt-1">@newCustomTileBackgroundImageWarning</div>
                            }
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Citation URL</label>
                            <input type="url" class="form-control form-control-sm" @bind="newCustomTileCitationUrl" placeholder="https://..." />
                            <div class="x-small text-muted mt-1">Leave blank to auto-link Wikipedia when possible.</div>
                        </div>
                        <div class="x-small text-muted">Large image files can impact rendering performance while panning/zooming.</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(addCustomTileError))
                    {
                        <div class="small text-danger mt-2">@addCustomTileError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CancelAddCustomTile">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="AddCustomTileAsync">@(IsEditingCustomTile ? "Save" : "Add Item")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showMaterialPicker)
{
    var pickerItems = MaterialPickerItems();
    var pickerGroups = pickerItems.GroupBy(item => item.Kind)
        .OrderBy(group => CatalogService.MaterialKindLabel(group.Key), StringComparer.Ordinal);

    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Change material</h5>
                    <button type="button" class="btn-close" @onclick="CloseMaterialPicker"></button>
                </div>
                <div class="modal-body material-picker-body">
                    <div class="row g-2 mb-2">
                        <div class="col-sm-8">
                            <label class="form-label small">Search</label>
                            <input class="form-control form-control-sm"
                                   value="@materialPickerSearch"
                                   @oninput="OnMaterialPickerSearchChanged"
                                   placeholder="Search materials" />
                        </div>
                        <div class="col-sm-4 d-flex align-items-end">
                            <label class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" checked="@materialPickerShowAll" @onchange="OnMaterialPickerShowAllChanged" />
                                <span class="form-check-label small">Show all</span>
                            </label>
                        </div>
                    </div>
                    @if (materialPickerPreferredKind is PaletteKind preferredKind && !materialPickerShowAll)
                    {
                        <div class="x-small text-muted mb-2">Showing @CatalogService.MaterialKindLabel(preferredKind) items by default.</div>
                    }
                    @if (pickerItems.Count == 0)
                    {
                        <div class="small text-muted">No catalog items match that filter.</div>
                    }
                    else
                    {
                        @foreach (var group in pickerGroups)
                        {
                            <div class="material-picker-group">
                                <div class="small fw-semibold text-muted mb-1">@CatalogService.MaterialKindLabel(group.Key)</div>
                                @foreach (var item in group)
                                {
                                    var isSelectedMaterial = string.Equals(materialPickerSelectedCode, item.Code, StringComparison.OrdinalIgnoreCase);
                                    <label class="material-picker-row @(isSelectedMaterial ? "selected" : string.Empty)">
                                        <input type="radio"
                                               name="material-picker"
                                               checked="@isSelectedMaterial"
                                               @onchange="(() => materialPickerSelectedCode = item.Code)" />
                                        <span class="gc-swatch material-picker-swatch" style="@MaterialPickerSwatchStyle(item)"></span>
                                        <span class="material-picker-copy">
                                            <span class="material-picker-name">@item.Code</span>
                                            <span class="material-picker-meta">@MaterialPickerDetails(item)</span>
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CloseMaterialPicker">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="ConfirmMaterialPickerAsync" disabled="@(string.IsNullOrWhiteSpace(materialPickerSelectedCode))">Apply</button>
                </div>
            </div>
        </div>
    </div>
}
